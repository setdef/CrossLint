// The markdown-links plugin: every relative link in a Markdown file points
// to a file or folder of the project, and its anchor, when it has one, to
// a heading or an HTML id or name of the Markdown file it points to.
artifact "markdown-file" {
  primary "{path}.md"
}

rule "links-resolve" ruby="rules/links_resolve.rb"

policy "links-resolve" {
  applies-to "markdown-file"
  rule "links-resolve"
}
