{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/app/shared/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/app/api/*.spec.ts", "src/app/menu/*.stub.ts"]
}
