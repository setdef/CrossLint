// The Angular plugin: ng-nudge's checks of an Angular project. Each policy
// has the name of the ng-nudge rule it runs, as configurations and debt
// files name them.
setting "src-dir"
setting "tsconfig"
setting "role"

// The roles component, directive, pipe, service, guard, resolver, and
// interceptor, inside src-dir, and each role the configuration changes or
// adds, declared from the settings.
artifacts ruby="artifacts.rb"

// Each artifact whose role expects a spec has one.
policy "spec-exists" {
  rule "companion-exists" companion="spec"
}

// A stub and an interface are optional, but a component with either has
// both.
policy "stub-exists" {
  applies-to "component"
  when companion-exists "interface"
  rule "companion-exists" companion="stub"
}

policy "interface-exists" {
  applies-to "component"
  when companion-exists "stub"
  rule "companion-exists" companion="interface"
}

// A component's stub and its interface have each input and output the
// component has, which the helper reads with the project's typescript.
rule "stub-matches-component" ruby="rules/stub_matches_component.rb"
rule "interface-matches-component" ruby="rules/interface_matches_component.rb"
helper "members" command="node" file="helpers/members.mjs"

policy "stub-matches-component" {
  applies-to "component"
  when companion-exists "stub"
  rule "stub-matches-component"
}

policy "interface-matches-component" {
  applies-to "component"
  when companion-exists "interface"
  rule "interface-matches-component"
}

policy "prefer-css-over-scss" {
  applies-to "component"
  when not { companion-exists "css"; }
  rule "companion-absent" companion="scss" severity="warning"
}
