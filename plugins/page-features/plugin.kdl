// The page-features plugin: every page component has a Gherkin feature
// file at the path its pattern gives.
setting "page"
setting "feature"

// The page components, each with its feature file as the piece
// "feature", declared from the settings.
helper "artifacts" command=(crosslint)"ruby" file="artifacts.rb"
artifacts helper="artifacts"

helper "feature-exists" command=(crosslint)"ruby" file="rules/feature_exists.rb"
rule "feature-exists" helper="feature-exists"

policy "feature-exists" {
  applies-to "page"
  rule "feature-exists"
}
