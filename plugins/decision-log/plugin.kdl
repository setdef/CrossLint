// The decision-log plugin: an index of decision records links to exactly
// the records in its folder, no two records have one number, and no
// Markdown file cites a record by a number no record has.
setting "folder"
setting "index"

// The index, and every Markdown file, each with the folder of records as
// a piece, declared from the settings.
helper "artifacts" command=(crosslint)"ruby" file="artifacts.rb"
artifacts helper="artifacts"

helper "index-lists-records" command=(crosslint)"ruby" file="rules/index_lists_records.rb"
rule "index-lists-records" helper="index-lists-records"
helper "numbers-unique" command=(crosslint)"ruby" file="rules/numbers_unique.rb"
rule "numbers-unique" helper="numbers-unique"
helper "citations-resolve" command=(crosslint)"ruby" file="rules/citations_resolve.rb"
rule "citations-resolve" helper="citations-resolve"

policy "index-lists-records" {
  applies-to "index"
  rule "index-lists-records"
}

policy "numbers-unique" {
  applies-to "index"
  rule "numbers-unique"
}

policy "citations-resolve" {
  applies-to "document"
  rule "citations-resolve"
}
