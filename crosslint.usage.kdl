// The command-line interface of `crosslint`, as a usage spec (https://usage.jdx.dev).
// The command reference is generated from this file.

min_usage_version "2.0.0"
name "CrossLint"
bin "crosslint"
version "0.2.0"
author "setdef"
license "MIT"
repository "https://github.com/setdef/CrossLint"

about "Check the rules that span files: every source file has its test, every component has its template"
long_about #"""
CrossLint checks how a project's files relate to each other: that each group of files that belong together has the files it should, and that a component and its stub agree. Its plugins declare which files belong together and what to check, and the project's configuration, .config/crosslint/config.kdl, lists the plugins it runs. A plugin can add commands under its own name, such as crosslint debt update, and crosslint --help lists the commands of the plugins the project lists.

Findings go to standard output, one per line. The lines CrossLint prints about itself go to standard error, and each begins with "crosslint:".
"""#
after_long_help #"""
Documentation: https://github.com/setdef/CrossLint/tree/trunk/docs Report a problem: https://github.com/setdef/CrossLint/issues
"""#

unknown_flags "error"

example "crosslint init" header="Write a configuration with the recommended plugins"
example "crosslint check" header="Check the project" help="Runs every plugin the configuration lists, prints each violation, and exits with 1 if any fails the check."
example "crosslint init --from-ng-nudge" header="Move a project from ng-nudge"

exit_code 0 "Every check passed, or the command did what it was asked."
exit_code 1 "A check failed: there is a violation that fails it, or a paid-off entry in the debt file."
exit_code 2 "CrossLint couldn't run: the command line, the configuration, or a plugin has a mistake, or a plugin's helper couldn't start, or a plugin stopped at a fault."
exit_code 130 "You interrupted CrossLint with Ctrl-C."

flag "-q --quiet" global=#true help="Print only what fails the check, with no summary"
flag "-s --silent" global=#true help="Print nothing but errors that stop CrossLint; only the exit status gives the result"
flag "--no-color" global=#true help="Print no color, as when NO_COLOR is set or the output isn't a terminal" {
  long_help "Prints no color. CrossLint colors only a finding's severity, and only on a terminal, and never when NO_COLOR is set to a value that isn't empty or TERM is dumb. FORCE_COLOR turns color on even off a terminal."
}
flag "--debug" global=#true help="Print what CrossLint does at each step, to standard error, as when DEBUG is set" {
  long_help "Prints what CrossLint does at each step, to standard error, as when DEBUG is set, and the trace of a fault. An error CrossLint expects, such as a mistake in the configuration, prints its message and the fix with no trace; one it doesn't expect says it is a bug in CrossLint and where to report it."
}
flag "-C --project <dir>" global=#true help="Use the project whose root, the folder with .config/crosslint/config.kdl, contains this folder"

cmd "check" effect="read" help="Check the project, and exit with 1 if a check fails" {
  long_help #"""
Runs every plugin the project's configuration lists, on the whole project, and prints each violation on a line of its own: the file, with the line for an artifact found inside it; the artifact's name, when it isn't the file's path; the message; and the plugin and policy it comes from. Ends with a summary of how many artifacts it checked and what it found.

A plugin's step can excuse violations, as the debt plugin does for those its debt file lists, and report paid-off entries: an entry no violation matches any more records a debt already paid, and fails the check until crosslint debt update removes it.
"""#
  flag "--warnings <mode>" help="Show warnings, hide them, or let them fail the check" {
    choices "all" "none" "error"
    default "all"
  }
  flag "-a --all" help="List every artifact checked, passing ones included; --json leaves passing ones out"
  flag "--json" help="Print the findings and the summary as one JSON object in place of lines" {
    long_help #"""
Prints one JSON object on one line of standard output in place of lines, with every character that isn't ASCII escaped. Everything else goes to standard error, as without --json: the faults, the summary line (not with --quiet or --silent), and the notices (not with --warnings=none or --silent, and with --quiet only under --warnings=error).

The object has these keys, in this order:

- "findings": an array with one object for each violation, with these keys, in this order. "path" is the artifact's primary file. "message", "plugin", and "policy" are strings. "artifact" is the artifact's name, which is its path unless its declaration names it otherwise. "role" is the artifact's kind. "severity" is "error" or "warning". "detail" is a string, or null when the rule gives none. "line" is the number of the line the artifact was found on, or null for an artifact that is a whole file. Every value but "detail" and "line" is a string. A violation the debt plugin adds when its report-entries setting is on, for an entry in the debt file, has the debt file as "artifact" and "path", "debt-file" as "role", the entry's line number as a string in "detail", and null as "line".
- "paid_off": an array with one object for each paid-off entry. "file" is the debt file, and "line" is the entry's line in it, a number. "plugin", "policy", "artifact", and "message" are strings.
- "summary": an object of four numbers: "artifacts", the artifacts checked, passing ones included; "errors"; "warnings"; and "paid_off".

A passing artifact is never in "findings", with or without --all. With --quiet, CrossLint leaves each warning that doesn't fail the check out of "findings", and "summary" still counts it. With --warnings=none, CrossLint leaves the warnings out of both. With --silent, CrossLint prints no object, so read the exit status.

A minor release may add keys, so a script should ignore keys it doesn't know.

For a project with one Ruby file and no test for it, the output is this, here with line breaks added:

    {
      "findings": [
        {
          "path": "lib/a.rb",
          "message": "no test file at test/a_test.rb",
          "plugin": "signatures",
          "policy": "has-test",
          "artifact": "lib/a.rb",
          "role": "ruby-file",
          "severity": "error",
          "detail": null,
          "line": null
        }
      ],
      "paid_off": [],
      "summary": {
        "artifacts": 1,
        "errors": 1,
        "warnings": 0,
        "paid_off": 0
      }
    }
"""#
  }
  example "crosslint check"
  example "crosslint check --warnings=error" header="Fail the check on warnings too"
  example "crosslint check --json" header="Read the findings from a script"
}

cmd "init" effect="write" help="Write a configuration for this project, with the recommended plugins" {
  long_help #"""
Writes .config/crosslint/config.kdl in the current folder, listing the recommended plugins. If the file exists, changes nothing unless you pass --force.

With --from-ng-nudge, reads .config/ng-nudge/rc.json instead, and writes a configuration with the Angular plugin, the debt plugin, and every setting rc.json had. With no rc.json, uses ng-nudge's defaults, as if rc.json held {}. Moves ng-nudge's debt file to .config/crosslint/debt.tsv with every entry and comment kept. Lists every change before it makes any, naming every setting the configuration it writes holds, in the file's order. When a setting, pattern, or expression can't be carried with the same meaning, lists every such problem and stops with exit status 2, changing nothing.
"""#
  flag "--from-ng-nudge" help="Write the configuration from this project's ng-nudge setup, and move its debt file"
  flag "-n --dry-run" help="List the changes, and make none"
  flag "-f --force" help="Replace an existing configuration, and with --from-ng-nudge an existing debt file"
  example "crosslint init"
  example "crosslint init --from-ng-nudge --dry-run" header="See what moving from ng-nudge would change"
}

cmd "update" effect="write" help="Move each shared plugin in the configuration to its newest compatible tag" {
  long_help #"""
Moves each shared plugin the configuration lists, a Git repository with a ref, to the highest version among the repository's tags written vX.Y.Z or X.Y.Z that is compatible with its ref, and rewrites only that ref's text in .config/crosslint/config.kdl. Compatible versions follow the rule Cargo and npm use for Semantic Versioning: from X.Y.Z on, the same X; from 0.Y.Z on, the same 0.Y; and at 0.0.Z only Z itself, so such a plugin doesn't move.

A plugin whose ref isn't a plain vX.Y.Z or X.Y.Z tag, such as a prerelease tag or a commit SHA, stays where it is, and so does one with no such tag. A plugin never moves to a lower version. When a repository has both vX.Y.Z and X.Y.Z, a ref keeps the form it was written in, and a plugin listed with path= keeps its path. Local and built-in plugins are left as they are.

Writes one line to standard error for each shared plugin, saying what changed or why nothing did. When the repository has newer versions that aren't compatible, the line goes on with "newer incompatible versions:", the highest tag of each, the lowest first, and the tag that crosslint update --latest moves to. That holds whether or not the plugin moved, and with --dry-run too.
"""#
  flag "-n --dry-run" help="List the changes, and make none"
  flag "--latest" help="Move to the highest version tag, even when it isn't compatible" {
    long_help "Moves each shared plugin whose ref is a plain version tag to the highest version among its repository's tags, even when that version isn't compatible with the ref and may break the project. It leaves a plugin whose ref isn't a plain version tag, or whose repository has no version tag, where it is, as it does without --latest. Combines with --dry-run."
  }
  example "crosslint update"
  example "crosslint update --dry-run" header="See which plugins have a newer compatible tag"
  example "crosslint update --latest" header="Move to the highest version, even when it isn't compatible"
}

cmd "help" effect="read" help="Explain one command, or list every command" {
  long_help "With a command, explains it, as crosslint COMMAND --help does. Without one, lists every command, as crosslint --help does."
  arg "[command]" help="The command to explain"
  example "crosslint help check"
}
