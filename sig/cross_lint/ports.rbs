module CrossLint
  # Where the core reads a project's configuration: a format, such as
  # KDL in `.config/crosslint/config.kdl`, and where its files are.
  # Adapters::KDLConfiguration reads the files, and
  # Adapters::MemoryConfiguration holds configurations in memory; both
  # pass Testing::ConfigurationContract.
  interface _Configuration
    # The configuration's path in a project's root, as messages name it,
    # such as ".config/crosslint/config.kdl".
    def file: () -> String

    # The project's root: the nearest folder, `start` or one above it,
    # that has a configuration, or nil when none does.
    def find_root: (String start) -> String?

    # The configuration of the project whose root is `root`. Raises
    # Core::Mistake, naming the file and the line, at a mistake in it, and
    # when the project has none.
    def read: (String root) -> Core::Configuration

    # Whether the project whose root is `root` has a configuration there,
    # as a file: `root` itself, not a folder above it. Raises
    # Core::Mistake when `root` isn't a folder.
    def exist?: (String root) -> bool

    # Replaces the configuration in `root` whole with `configuration`,
    # written so that `read` returns it again, but for the lines of its
    # plugins, settings, and policy lines, which the port sets. Makes the
    # folders the file is in when there are none, and leaves the file as
    # it was when the write fails. Raises Core::Mistake, naming the file,
    # when it can't write, and when `root` isn't a folder.
    def write: (String root, Core::Configuration configuration) -> void

    # Sets the ref of each plugin the configuration of `root` lists, by
    # its URL and path (nil for a plugin with none), that is a key of
    # `refs`, to its value, and
    # changes nothing else of the configuration: with a file, every other
    # byte stays. Raises Core::Mistake, naming the file and the line, when
    # a plugin has no ref it can rewrite, and when the project has none.
    def set_refs: (String root, Hash[[String, String?], String] refs) -> void
  end

  # Where the core reads each plugin's manifest: a format, such as KDL in
  # `plugin.kdl`, and where its files are. Adapters::KDLPluginManifests
  # reads the files, and Adapters::MemoryPluginManifests holds manifests
  # in memory; both pass Testing::PluginManifestsContract.
  interface _PluginManifests
    # The manifest's file name in a plugin's folder, such as "plugin.kdl".
    def file: () -> String

    # The manifest of the plugin in `folder`, a path relative to `root`,
    # or nil when the folder has none. Raises Core::Mistake, naming the
    # file and the line, at a mistake in it.
    def read: (String root, String folder) -> Core::Manifest?
  end

  # Where the core finds a project's files, as Git sees its working tree,
  # and asks whether a path exists. Adapters::GitProjectFiles asks Git and
  # the filesystem, and Adapters::MemoryProjectFiles holds the files in
  # memory; both pass Testing::ProjectFilesContract.
  interface _ProjectFiles
    # The files of the project whose root is `root`, as Git sees its
    # working tree: tracked files, and untracked files Git doesn't ignore,
    # with nothing under `.git/`. Each is a path relative to `root`, with
    # `/` between folders, in no particular order. Raises Core::Mistake
    # when `root` isn't in a Git working tree.
    def files: (String root) -> Array[String]

    # Whether a file or folder exists at `path`, relative to `root` with
    # `/` between folders, by its exact name: a name that differs only in
    # case doesn't count, even on a filesystem that ignores case. A file
    # Git ignores counts.
    def exist?: (String root, String path) -> bool

    # The bytes of the file at `path`, relative to `root` with `/` between
    # folders, as a UTF-8 string, line endings as they are. Raises
    # Errno::ENOENT when no file exists at `path` by its exact name.
    def read: (String root, String path) -> String
  end

  # Where the core loads a plugin's Ruby files, such as its rules.
  # Adapters::FilePluginRuby runs the files in the plugin's folder, and
  # Adapters::MemoryPluginRuby holds code in memory; both pass
  # Testing::PluginRubyContract.
  interface _PluginRuby
    # Runs the Ruby file `file`, relative to `plugin`'s folder, with its
    # constants in `namespace` rather than at the top level, so that two
    # plugins' classes of one name stay apart. Raises Core::Mistake,
    # naming the plugin's manifest and `line`, the line with the file's
    # name, when the folder has no such file; raises whatever the file
    # raises.
    def load: (Core::Plugin plugin, String file, Integer line, Module namespace) -> void
  end

  # Where the core runs plugins' helpers, programs in another language
  # that answer a rule's requests. Adapters::ProcessHelpers runs each as a
  # process, and Adapters::MemoryHelpers answers with procs in memory;
  # both pass Testing::HelpersContract.
  interface _Helpers
    # Finds the command each helper of `plugins` runs on, before any
    # helper starts, and returns them ready to start in `root`, the
    # project's root. Raises Core::Mistake, naming the plugin's manifest,
    # the helper's line, the plugin, and the command, when a command
    # isn't on the PATH.
    def start: (String root, Array[Core::Plugin] plugins) -> _RunningHelpers
  end

  # The helpers of a check, each started the first time a rule calls it,
  # and kept running for the rest of the check.
  interface _RunningHelpers
    # Sends `input` to `plugin`'s helper `name`, one the plugin declares,
    # and returns what the helper answers. Raises Core::PluginError, whose
    # message says what the helper did and what it wrote to standard
    # error, when the helper fails: exits, answers with what isn't JSON,
    # or doesn't answer within a time limit.
    def call: (Core::Plugin plugin, String name, untyped input) -> untyped

    # Closes each helper's input, waits for the helpers to exit, all at
    # once, up to a time limit each, and ends each one that is still
    # running and everything it started.
    def stop: () -> void

    # Ends each helper and everything it started at once, without
    # waiting for any of them: what Ctrl-C does.
    def kill: () -> void
  end

  # Where a check's result goes: a format, such as lines of text or JSON,
  # and where it is written. Adapters::TextReport and Adapters::JSONReport
  # write to standard output and standard error, and Adapters::MemoryReport
  # holds results in memory; all three pass Testing::ReportContract.
  interface _Report
    # Says, where someone waits for the check, which artifacts it is
    # about to check: `kinds` has the count of each kind, by name.
    # Adapters::TextReport writes the line only to a terminal.
    def start: (Array[[String, Integer]] kinds) -> void

    # Reports `result`: its findings, stale entries among them, and
    # notices as they are, in their order, each line a step wrote, its
    # summary unless its verbosity is `:quiet` or `:silent`, and its
    # faults whatever the verbosity. Under `:silent`, writes nothing but
    # the faults.
    def write: (Core::CheckResult result) -> void
  end

  # Where the core reads and writes a project's debt file: a format, such
  # as ng-nudge's tab-separated values, and where its files are.
  # Adapters::TSVDebtFiles reads and writes the files, and
  # Adapters::MemoryDebtFiles holds them in memory; both pass
  # Testing::DebtFilesContract.
  interface _DebtFiles
    # The debt file at `path`, relative to `root` with `/` between
    # folders: its entries, in order, each with the line it starts on and
    # its source, and its header. A file that doesn't exist has no entries
    # and no header. Raises Core::Mistake, naming `path` and the line, at
    # a mistake in it, such as an entry with no rule or no artifact.
    def read: (String root, String path) -> Core::DebtFile

    # Replaces the file at `path`, relative to `root`, whole with `debt`:
    # its header, or a header of the port's own when it has none, and its
    # entries in order, each written as its source when it has one. Makes
    # the file's folder when there is none, and leaves the file as it was
    # when the write fails.
    def write: (String root, String path, Core::DebtFile debt) -> void

    # Whether a file exists at `path`, relative to `root` with `/` between
    # folders.
    def exist?: (String root, String path) -> bool

    # Moves the file at `from` to `to`, both relative to `root`, as it
    # is, byte for byte, without reading it as entries, so that a file with
    # a mistake moves too. Replaces a file at `to`, makes the folder it is
    # in when there is none, and leaves nothing at `from`. Raises
    # Core::Mistake, naming `from`, when there is no file there, and
    # naming the file when the system denies the move; the file at `to` is
    # as it was then.
    def move: (String root, String from, String to) -> void
  end

  # Where the core fetches shared plugins from: Git repositories, and the
  # user's cache of what it has fetched. Adapters::GitSharedPlugins runs
  # Git, and Adapters::MemorySharedPlugins holds repositories in memory;
  # both pass Testing::SharedPluginsContract. Before a request, each
  # writes a line to standard error that says what it is about to fetch
  # or list: "crosslint: fetching URL at REF" or "crosslint: listing the
  # tags of URL".
  interface _SharedPlugins
    # Whether `url` is one a configuration may list as a shared plugin:
    # it starts with a scheme the port accepts, "https://" unless it is
    # told more.
    def accepts?: (String url) -> bool

    # The folder in the cache that holds the plugin at `ref` of the
    # repository at `url`, a tag or a full commit SHA, as files with no
    # repository. Its name is the plugin's name (Core::SharedPlugin.plugin_name).
    # The first time, it fetches that commit alone and saves it; after
    # that it makes no request, even when the tag has moved. Raises
    # Core::FetchError when `url` isn't accepted, the repository or the ref
    # can't be reached, the ref names a branch and no tag, the SHA isn't
    # in the repository, or the fetch takes more than its time limit, and
    # saves nothing then.
    def fetch: (String url, String ref) -> String

    # The folder `fetch` returned for `url` at `ref` before, or nil when it
    # hasn't fetched that plugin, or when `url` or `ref` is one it
    # wouldn't fetch. It makes no request, says nothing, and saves
    # nothing, so a help that must not touch the network can ask it.
    def cached: (String url, String ref) -> String?

    # The names of the repository's tags at `url`. Raises Core::FetchError
    # when the repository can't be reached within the time limit.
    def tags: (String url) -> Array[String]
  end

  # Where the core finds what ng-nudge 0.3.0 keeps in a project:
  # `.config/ng-nudge/rc.json`, and the files in its `artifacts/`,
  # `policies/`, and `rules/` folders. Adapters::FileNgNudge reads the
  # files, and Adapters::MemoryNgNudge holds them in memory; both pass
  # Testing::NgNudgeContract. The debt file is read through the
  # debt-files port.
  interface _NgNudge
    # The text of `.config/ng-nudge/rc.json` in `root`, or nil when
    # there is none. Raises Core::Mistake, naming the file, when it isn't
    # valid UTF-8.
    def settings: (String root) -> String?

    # The paths, relative to `root` with `/` between folders and sorted
    # by folder and then by name, of the files ng-nudge loads from its
    # extension folders: names ending in `.artifact.js` in
    # `.config/ng-nudge/artifacts/`, in `.config/ng-nudge/policies/` those
    # ending in `.policy.js`, and in `.config/ng-nudge/rules/` those ending
    # in `.rule.js`, a name that starts with a dot among them, and nothing
    # in a folder below those.
    def extensions: (String root) -> Array[String]
  end

  # Where the core asks JavaScript a question that only JavaScript
  # answers, so that a conversion from ng-nudge doesn't depend on a
  # translation alone. Adapters::NodeJavaScript runs Node, and
  # Adapters::MemoryJavaScript answers from procs in memory; both pass
  # Testing::JavaScriptContract.
  interface _JavaScript
    # Which of `texts` the JavaScript regular expression `source`, with
    # no flags, matches anywhere in, as `new RegExp(source).test(text)`
    # says, in the order of `texts`, and, with none, only compiles it.
    # Raises Core::InvalidExpression, with what JavaScript said, when it
    # says `source` isn't a valid expression, and Core::JavaScriptError, with
    # the reason, when JavaScript can't be run or doesn't answer.
    def matches: (String source, Array[String] texts) -> Array[bool]

    # The files the project's own glob package, node-glob, finds for each
    # of `patterns`, by the pattern, with `cwd`, a folder relative to
    # `root`, as the folder to look in: each a path relative to `cwd` with
    # `/` between folders, in the order glob gives them, folders and files
    # Git ignores among them. The package is the one `require("glob")`
    # finds from the first of `packages`, folders relative to `root`, that
    # has one. Gives nil when none does. Raises Core::JavaScriptError, with
    # the reason, when JavaScript can't be run, doesn't answer, or glob
    # fails.
    def glob: (String root, String cwd, Array[String] patterns, Array[String] packages) -> Hash[String, Array[String]]?
  end
end
