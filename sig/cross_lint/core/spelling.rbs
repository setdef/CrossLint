module CrossLint
  module Core
    # The nearest valid spelling of a word someone typed, for the message
    # that refuses it.
    #
    # ```ruby
    # CrossLint::Core::Spelling.unknown("node", "file", ["files", "piece"])
    # # => "unknown node \"file\", did you mean \"files\"?"
    # CrossLint::Core::Spelling.unknown("node", "zzz", ["files", "piece"])
    # # => "unknown node \"zzz\"; expected \"files\" or \"piece\""
    # ```
    module Spelling
      # The word among `known` that `word` most likely misspells, or nil.
      def self?.nearest: (String word, Array[String] known) -> String?

      # The message for `word`, an unknown `kind` of thing: with the
      # nearest of `known`, or else all of them, or `none` when there are
      # none.
      def self?.unknown: (String kind, String word, Array[String] known, ?none: String) -> String

      # `number` of `noun`, which gets an s unless `number` is 1:
      # "1 artifact", "0 artifacts".
      def self?.count: (Integer number, String noun) -> String

      # Words joined as in a sentence: "a", "a or b", "a, b, or c", with
      # `conjunction` in place of "or" when given, as in "a, b, and c".
      def self?.list: (Array[String] words, ?String conjunction) -> String
    end
  end
end
