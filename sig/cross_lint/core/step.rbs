module CrossLint
  module Core
    # A step a plugin runs after every rule of every plugin has run, which
    # sees every violation, whatever --warnings or --quiet hides, and can
    # excuse some, add others, and report paid-off entries. A manifest names
    # one as `step NAME`; Core::TrackDebt is one.
    interface _Step
      # The names of the policies whose violations the step adds, each of
      # which its plugin's manifest declares with no block.
      def policies: () -> Array[String]

      # Reads `settings`, the plugin's settings in the configuration at
      # `file`. Raises Mistake, naming `file` and the line, at a setting
      # the step takes but can't use.
      def check_settings: (Array[Setting] settings, String file) -> void

      # What the step does with `input`.
      def call: (StepInput input) -> StepResult
    end

    # An entry no current violation matches, which fails the check until
    # someone removes it: the plugin and policy it is for, its artifact,
    # and where it is.
    class PaidOffEntry < Data
      # The name of the plugin whose policy the entry is for.
      attr_reader plugin: String

      # The policy's name.
      attr_reader policy: String

      # The entry's artifact, as the entry has it.
      attr_reader artifact: String

      # The file the entry is in, relative to the project's root.
      attr_reader file: String

      # The line the entry is on.
      attr_reader line: Integer

      # What to do about it, such as "crosslint debt update removes it".
      attr_reader message: String

      # A paid-off entry with these fields.
      def self.new: (plugin: String, policy: String, artifact: String, file: String, line: Integer, message: String) -> instance

      # A paid-off entry with these fields.
      def initialize: (plugin: String, policy: String, artifact: String, file: String, line: Integer, message: String) -> void
    end

    # What a step sees: the project, its own plugin, every violation the
    # rules reported, the plugins that stopped at a fault, and the name of
    # the command the person ran, if it is one of its plugin's.
    class StepInput < Data
      # The project checked.
      attr_reader project: Project

      # The plugin whose step this is.
      attr_reader plugin: Plugin

      # Every violation every plugin's rules reported.
      attr_reader violations: Array[Violation]

      # The names of the plugins that stopped at a fault, which reported
      # no violation.
      attr_reader faulted: Array[String]

      # The name of the command given on the command line, such as
      # "update", when the plugin declares it, and nil when the check runs
      # on its own or runs another plugin's command.
      attr_reader command: String?

      # The flags of that command the person gave, by long name: true for
      # one that takes no value, or its value. Empty when `command` is nil.
      attr_reader flags: Hash[String, String | true]

      # A step's input with these fields.
      def self.new: (project: Project, plugin: Plugin, violations: Array[Violation], faulted: Array[String],
                     command: String?, flags: Hash[String, String | true]) -> instance

      # A step's input with these fields.
      def initialize: (project: Project, plugin: Plugin, violations: Array[Violation], faulted: Array[String],
                       command: String?, flags: Hash[String, String | true]) -> void
    end

    # What a step did: the violations it excuses, those it adds, the
    # paid-off entries it reports, its warnings, what it wrote, and what the
    # summary says of it.
    class StepResult < Data
      # The violations it excuses, which then don't fail the check.
      attr_reader excused: Array[Violation]

      # The violations it adds, of its plugin's policies.
      attr_reader violations: Array[Violation]

      # The paid-off entries it reports.
      attr_reader paid_off: Array[PaidOffEntry]

      # Its warnings, which never fail the check.
      attr_reader notices: Array[Notice]

      # A line for each file it wrote, such as "wrote debt.tsv: 2 entries
      # added, 0 removed".
      attr_reader wrote: Array[String]

      # What the summary says of it, such as "2 accepted as debt".
      attr_reader summary: Array[String]

      # A step's result with these fields.
      def self.new: (excused: Array[Violation], violations: Array[Violation], paid_off: Array[PaidOffEntry], notices: Array[Notice],
                     wrote: Array[String], summary: Array[String]) -> instance

      # A step's result with these fields.
      def initialize: (excused: Array[Violation], violations: Array[Violation], paid_off: Array[PaidOffEntry], notices: Array[Notice],
                       wrote: Array[String], summary: Array[String]) -> void
    end
  end
end
