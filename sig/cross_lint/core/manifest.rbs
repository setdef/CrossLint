module CrossLint
  module Core
    # A piece an artifact declares: its name, and the path pattern
    # that gives its path for each primary file.
    class PieceDeclaration < Data
      # The piece's name, unique within its artifact, such as "test".
      attr_reader name: String

      # Where the piece is for each primary file.
      attr_reader pattern: PathPattern

      # The line the declaration is on.
      attr_reader line: Integer

      # The regex the piece is a match of in the file at its path, or nil
      # for a piece that is the whole file.
      attr_reader regex: Regex?

      # A piece with these fields, and no regex unless given.
      def self.new: (name: String, pattern: PathPattern, line: Integer, ?regex: Regex?) -> instance

      # A piece with these fields, as for `new`.
      def initialize: (name: String, pattern: PathPattern, line: Integer, ?regex: Regex?) -> void
    end

    # A kind of artifact a plugin declares: the pattern that finds its
    # primary files, and where each of its pieces is.
    class ArtifactDeclaration < Data
      # The artifact's name, unique within its plugin, such as "ruby-file".
      attr_reader name: String

      # The pattern that finds the primary files, relative to the
      # project's root.
      attr_reader primary: PathPattern

      # The artifact's pieces, in the order they are declared.
      attr_reader pieces: Array[PieceDeclaration]

      # The line the declaration is on.
      attr_reader line: Integer

      # The pattern that gives each artifact's key, the name a debt entry
      # can give it by in place of its primary path, or nil for none.
      attr_reader key: PathPattern?

      # Whether a project may well have no file of the artifact, so that a
      # primary pattern that matches none is reported only when no artifact
      # of the plugin matches one.
      attr_reader optional: bool

      # Whether a file may match with a file or a folder whose name starts
      # with `.` in what a placeholder matches. When false, such a file is
      # no artifact, as in a glob that skips dotfiles.
      attr_reader dotfiles: bool

      # The pattern that gives each artifact's name, from the primary
      # pattern's placeholders and its regex's captures, or nil to name
      # each by its primary path.
      attr_reader name_pattern: PathPattern?

      # The regex each match of which in a primary file is an artifact,
      # or nil for one artifact per primary file.
      attr_reader regex: Regex?

      # An artifact with these fields, with no key or name pattern and no
      # regex, not optional, and with dot-named files unless given.
      def self.new: (name: String, primary: PathPattern, pieces: Array[PieceDeclaration], line: Integer,
                     ?key: PathPattern?, ?optional: bool, ?dotfiles: bool, ?name_pattern: PathPattern?, ?regex: Regex?) -> instance

      # An artifact with these fields, as for `new`.
      def initialize: (name: String, primary: PathPattern, pieces: Array[PieceDeclaration], line: Integer,
                       ?key: PathPattern?, ?optional: bool, ?dotfiles: bool, ?name_pattern: PathPattern?, ?regex: Regex?) -> void

      # The placeholders a piece's pattern or regex, and the name, may
      # use: the primary pattern's, then its regex's captures.
      def placeholders: () -> Array[String]

      # The names of the captures of the regex, or none without one.
      def captures: () -> Array[String]

      # The captures that the name, a piece's pattern, or a piece's regex
      # uses.
      def used_captures: () -> Array[String]

      # Why something of the declaration can't use `placeholder`, as a
      # verb phrase: "uses {x}, which the primary pattern ... doesn't
      # have".
      def lacking: (String placeholder) -> String

      # The piece called `name`, or nil.
      def piece: (String name) -> PieceDeclaration?
    end

    # The artifact a policy covers: one of its plugin's, by name, or
    # another listed plugin's, as PLUGIN/ARTIFACT.
    class AppliesTo < Data
      # The artifact's name, or PLUGIN/ARTIFACT.
      attr_reader artifact: String

      # The line `applies-to` is on.
      attr_reader line: Integer

      # The artifact `artifact`, named on `line`.
      def self.new: (artifact: String, line: Integer) -> instance

      # The artifact `artifact`, named on `line`.
      def initialize: (artifact: String, line: Integer) -> void
    end

    # A rule a policy runs: the rule's name, its arguments, and the
    # severity the policy gives its violations, if it gives one.
    class PolicyRule < Data
      # The rule's name: a built-in rule's, or one the plugin declares.
      attr_reader name: String

      # The rule's arguments, such as `{"piece" => "test"}`.
      attr_reader arguments: Hash[String, untyped]

      # The severity of the rule's violations under this policy, or nil
      # for the rule's default.
      attr_reader severity: severity?

      # The line the rule is on.
      attr_reader line: Integer

      # A policy's rule with these fields.
      def self.new: (name: String, arguments: Hash[String, untyped], severity: severity?, line: Integer) -> instance

      # A policy's rule with these fields.
      def initialize: (name: String, arguments: Hash[String, untyped], severity: severity?, line: Integer) -> void
    end

    # A policy: when rules apply, to which artifact, and under what
    # condition.
    class Policy < Data
      # The policy's name, unique within its plugin, which violations
      # carry.
      attr_reader name: String

      # The artifact the policy covers, or nil when it has no applies-to,
      # for each of its plugin's artifacts that has every piece it
      # names.
      attr_reader applies_to: AppliesTo?

      # The condition an artifact meets for the policy to apply, or nil
      # for every artifact.
      attr_reader condition: condition?

      # The rules the policy runs, one or more.
      attr_reader rules: Array[PolicyRule]

      # The line the policy is on.
      attr_reader line: Integer

      # A policy with these fields.
      def self.new: (name: String, applies_to: AppliesTo?, condition: condition?, rules: Array[PolicyRule],
                     line: Integer) -> instance

      # A policy with these fields.
      def initialize: (name: String, applies_to: AppliesTo?, condition: condition?, rules: Array[PolicyRule],
                       line: Integer) -> void

      # The names of the pieces its condition and its rules name,
      # each once.
      def pieces: () -> Array[untyped]
    end

    # A rule written in Ruby that a plugin declares.
    class RuleDeclaration < Data
      # The rule's name, which a policy runs it by.
      attr_reader name: String

      # The rule's file, relative to the plugin's folder, for a rule in the
      # plugin's Ruby, declared as `rule NAME ruby=FILE`; or nil.
      attr_reader ruby: String?

      # The name of the plugin's helper that runs the rule, for a rule
      # declared as `rule NAME helper=HELPER`; or nil.
      attr_reader helper: String?

      # The line the declaration is on.
      attr_reader line: Integer

      # A rule with these fields, one of `ruby` and `helper` given.
      def self.new: (name: String, ?ruby: String?, ?helper: String?, line: Integer) -> instance

      # A rule with these fields, one of `ruby` and `helper` given.
      def initialize: (name: String, ?ruby: String?, ?helper: String?, line: Integer) -> void
    end

    # A helper a plugin declares: a program in another language that its
    # Ruby rules call.
    class HelperDeclaration < Data
      # The helper's name, which a Ruby rule calls it by.
      attr_reader name: String

      # The program the helper runs on, such as "node", found on the PATH.
      attr_reader command: String

      # The helper's file, relative to the plugin's folder.
      attr_reader file: String

      # The line the declaration is on.
      attr_reader line: Integer

      # The words the program takes before the helper's file, such as
      # `["exec", "ruby"]` for `bundle exec ruby`.
      attr_reader arguments: Array[String]

      # A helper with these fields, and no arguments unless given.
      def self.new: (name: String, command: String, file: String, line: Integer, ?arguments: Array[String]) -> instance

      # A helper with these fields, and no arguments unless given.
      def initialize: (name: String, command: String, file: String, line: Integer, ?arguments: Array[String]) -> void

      # The mistake to stop at when `plugin`'s helper has no command on the
      # PATH: it names the plugin's manifest, the line, the plugin, and the
      # command.
      def missing_command: (Plugin plugin) -> Mistake
    end

    # A policy no rule runs, whose violations one of its plugin's steps
    # reports, declared as `policy NAME` with no block.
    class StepPolicy < Data
      # The policy's name.
      attr_reader name: String

      # The line it is declared on.
      attr_reader line: Integer

      # A step's policy with these fields.
      def self.new: (name: String, line: Integer) -> instance

      # A step's policy with these fields.
      def initialize: (name: String, line: Integer) -> void
    end

    # A setting the plugin takes in its block in the configuration,
    # declared as `setting NAME`.
    class SettingDeclaration < Data
      # The setting's name, such as "file".
      attr_reader name: String

      # The line it is declared on.
      attr_reader line: Integer

      # A setting declaration with these fields.
      def self.new: (name: String, line: Integer) -> instance

      # A setting declaration with these fields.
      def initialize: (name: String, line: Integer) -> void
    end

    # A flag a command declares, as `flag "-n --dry-run" help=TEXT` inside
    # its block: scoped to that command, in the usage spec's flag syntax,
    # with no long help, choices, or default unless given.
    class CommandFlag < Data
      # The flag's one-letter name, such as "n", or nil for none.
      attr_reader short: String?

      # The flag's long name, such as "dry-run".
      attr_reader long: String

      # The name of the value the flag takes, or nil for none.
      attr_reader value: String?

      # The flag's line of help.
      attr_reader help: String

      # The line it is declared on.
      attr_reader line: Integer

      # The flag's longer help, or nil for none.
      attr_reader long_help: String?

      # The values the flag takes, or nil for any.
      attr_reader choices: Array[String]?

      # The value the flag has when it isn't given, or nil for none.
      attr_reader default: String?

      # A flag with these fields, and no longer help, choices, or default
      # unless given.
      def self.new: (short: String?, long: String, value: String?, help: String, line: Integer, ?long_help: String?,
                     ?choices: Array[String]?, ?default: String?) -> instance

      # A flag with these fields, and no longer help, choices, or default
      # unless given.
      def initialize: (short: String?, long: String, value: String?, help: String, line: Integer, ?long_help: String?,
                       ?choices: Array[String]?, ?default: String?) -> void

      # How the flag is written with its value, such as "--since <rev>".
      def usage: () -> String

      # Each name the flag is given on a command line, such as "--dry-run"
      # and "-n".
      def names: () -> Array[String]
    end

    # A command the plugin adds under its own name, declared as
    # `command NAME help=TEXT`, which a project runs as
    # `crosslint PLUGIN NAME`, with the flags in its block.
    class CommandDeclaration < Data
      # The command's name, such as "update".
      attr_reader name: String

      # The command's one line of help.
      attr_reader help: String

      # The line it is declared on.
      attr_reader line: Integer

      # The flags the command takes, besides CrossLint's global ones.
      attr_reader flags: Array[CommandFlag]

      # A command declaration with these fields, and no flags unless given.
      def self.new: (name: String, help: String, line: Integer, ?flags: Array[CommandFlag]) -> instance

      # A command declaration with these fields, and no flags unless given.
      def initialize: (name: String, help: String, line: Integer, ?flags: Array[CommandFlag]) -> void
    end

    # A step the plugin runs after every rule has run, declared as
    # `step NAME`, by the name of a step built into CrossLint.
    class StepDeclaration < Data
      # The step's name, such as "track-debt".
      attr_reader name: String

      # The line it is declared on.
      attr_reader line: Integer

      # A step declaration with these fields.
      def self.new: (name: String, line: Integer) -> instance

      # A step declaration with these fields.
      def initialize: (name: String, line: Integer) -> void
    end

    # What a plugin's manifest declares: its artifacts, policies, rules,
    # helpers, the policies its steps report, its settings, its commands,
    # and its steps.
    class Manifest < Data
      # The manifest's path, relative to its project's root, as messages
      # name it.
      attr_reader file: String

      # The artifacts, in the order they are declared.
      attr_reader artifacts: Array[ArtifactDeclaration]

      # The policies, in the order they are declared.
      attr_reader policies: Array[Policy]

      # The rules written in Ruby, in the order they are declared.
      attr_reader rules: Array[RuleDeclaration]

      # The helpers, in the order they are declared.
      attr_reader helpers: Array[HelperDeclaration]

      # The policies its steps report, in the order they are declared.
      attr_reader step_policies: Array[StepPolicy]

      # The settings it takes, in the order they are declared.
      attr_reader settings: Array[SettingDeclaration]

      # The commands it adds, in the order they are declared.
      attr_reader commands: Array[CommandDeclaration]

      # Its steps, in the order they are declared.
      attr_reader steps: Array[StepDeclaration]

      # The file whose Ruby declares more artifacts from the plugin's
      # settings, or nil.
      attr_reader artifacts_ruby: ArtifactsRuby?

      # The helper that declares more artifacts from the plugin's
      # settings, or nil.
      attr_reader artifacts_helper: ArtifactsHelper?

      # A manifest with these fields, and none of the last six unless
      # given.
      def self.new: (file: String, artifacts: Array[ArtifactDeclaration], policies: Array[Policy],
                     rules: Array[RuleDeclaration], helpers: Array[HelperDeclaration], ?step_policies: Array[StepPolicy],
                     ?settings: Array[SettingDeclaration], ?commands: Array[CommandDeclaration], ?steps: Array[StepDeclaration],
                     ?artifacts_ruby: ArtifactsRuby?, ?artifacts_helper: ArtifactsHelper?) -> instance

      # A manifest with these fields, and none of the last six unless
      # given.
      def initialize: (file: String, artifacts: Array[ArtifactDeclaration], policies: Array[Policy],
                       rules: Array[RuleDeclaration], helpers: Array[HelperDeclaration], ?step_policies: Array[StepPolicy],
                       ?settings: Array[SettingDeclaration], ?commands: Array[CommandDeclaration], ?steps: Array[StepDeclaration],
                       ?artifacts_ruby: ArtifactsRuby?, ?artifacts_helper: ArtifactsHelper?) -> void
    end

    # The file of a plugin's Ruby that declares artifacts from its
    # settings, declared as `artifacts ruby=FILE`.
    class ArtifactsRuby < Data
      # The file, relative to the plugin's folder.
      attr_reader ruby: String

      # The line it is declared on.
      attr_reader line: Integer

      # A declaration with these fields.
      def self.new: (ruby: String, line: Integer) -> instance

      # A declaration with these fields.
      def initialize: (ruby: String, line: Integer) -> void
    end

    # The helper of a plugin that declares artifacts from its settings,
    # declared as `artifacts helper=HELPER`.
    class ArtifactsHelper < Data
      # The helper's name, one the plugin declares.
      attr_reader helper: String

      # The line it is declared on.
      attr_reader line: Integer

      # A declaration with these fields.
      def self.new: (helper: String, line: Integer) -> instance

      # A declaration with these fields.
      def initialize: (helper: String, line: Integer) -> void
    end
  end
end
