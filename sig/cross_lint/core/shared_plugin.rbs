module CrossLint
  module Core
    # What a shared plugin's URL and ref must look like.
    #
    # ```ruby
    # CrossLint::Core::SharedPlugin.plugin_name("https://github.com/OWNER/signatures.git") # => "signatures"
    # CrossLint::Core::SharedPlugin.ref?("v1.2.0") # => true
    # CrossLint::Core::SharedPlugin.ref?("main:other") # => false
    # ```
    module SharedPlugin
      # A plugin's name: letters, digits, and . _ -.
      NAME: Regexp

      # A full commit SHA, 40 hexadecimal digits.
      SHA: Regexp

      # A tag name, such as "v1.2.0": no character Git reads as part of a
      # refspec.
      TAG: Regexp

      # The name of the plugin at `url`: the last path segment of the URL without
      # a ".git" after it, or nil when that has a character a name
      # can't, or is "." or "..".
      def self.plugin_name: (String url) -> String?

      # What is wrong with `path`, the folder of a repository that holds a
      # plugin, said to finish "a path= that", or nil when nothing is:
      # it is empty, has a backslash, is absolute or has a drive letter,
      # has an empty part, ".", or "..", or ends in a name that is no plugin's.
      def self.path_problem: (String path) -> String?

      # What a mistake says of a listing of the plugin at `url`, at `ref`,
      # whose `path=` is `path`, or nil when `path` is nil or nothing is
      # wrong with it: the problem `path_problem` gives, and the path.
      def self.path_refusal: (String url, String ref, String? path) -> String?

      # Whether `ref` is a full commit SHA or a tag name.
      def self.ref?: (String ref) -> bool

      # Whether `ref` is a full commit SHA.
      def self.sha?: (String ref) -> bool

      # Whether the URL `url` has a user name or password, as in
      # https://user:token@host/path.
      def self.credentials?: (String url) -> bool

      # Raises Mistake.credentials, for the first plugin `configuration`
      # lists whose name is a URL with a user name or password.
      def self.refuse_credentials: (Configuration configuration) -> void
    end
  end
end
