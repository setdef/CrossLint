module CrossLint
  module Core
    # A tag that names a version, vX.Y.Z or X.Y.Z with integers, and no
    # prerelease or build part, as written in the tag. Two tags are equal
    # only when their text is, so v1.2.0 and 1.2.0 are two tags of one
    # version. To order tags, compare their versions. Only `parse` makes
    # one, so a tag's text and version always agree.
    #
    # ```ruby
    # tag = CrossLint::Core::VersionTag.parse("v1.4.0")
    # tag.version.compatible_with?(CrossLint::Core::VersionTag.parse("1.10.0").version) # => true
    # tag.version.compatible_with?(CrossLint::Core::VersionTag.parse("v2.0.0").version) # => false
    # CrossLint::Core::VersionTag.parse("v1.4.0-rc.1") # => nil
    # ```
    class VersionTag < Data
      # A tag that is a version: three integers, with an optional "v"
      # before them and nothing after.
      PATTERN: Regexp

      # The tag as written, such as "v1.4.0".
      attr_reader text: String

      # The version the text names.
      attr_reader version: Version

      # The version tag that `text` is, or nil when it is no version tag,
      # such as a prerelease tag, a branch, or a commit SHA.
      def self.parse: (String text) -> VersionTag?

      # Whether the tag is written with a "v" before its numbers.
      def v?: () -> bool

      private

      def self.new: (text: String, version: Version) -> instance

      def initialize: (text: String, version: Version) -> void

      def with: (?text: String, ?version: Version) -> instance
    end
  end
end
