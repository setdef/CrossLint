module CrossLint
  module Core
    # Finds a project's artifacts: each primary piece a declaration's
    # primary pattern matches, with the artifact's other pieces, and
    # whether each exists, by its exact name or, for a piece with a regex,
    # by a match in its file. It reads each file once.
    class ArtifactFinder
      # What stops finding a plugin's artifacts, with the fault to report.
      class Stopped < StandardError
        # The fault, of the role whose artifacts CrossLint was finding.
        attr_reader fault: Fault

        # The error for `fault`.
        def initialize: (Fault fault) -> void
      end

      # A finder among `files`, the project's files relative to `root`,
      # which asks `project_files` whether each piece exists.
      def initialize: (project_files: _ProjectFiles, root: String, files: Array[String]) -> void

      # The artifacts of each of `plugin`'s declarations, by the
      # declaration's name, in the order of the files and then of the
      # matches of a primary's regex in each. Raises Stopped
      # when two artifacts of one declaration have one name, and when a
      # regex runs past its time limit or meets a file that isn't UTF-8.
      def artifacts: (Plugin plugin) -> Hash[String, Array[Artifact]]

      private

      @project_files: _ProjectFiles

      @root: String

      @files: Array[String]

      @texts: Hash[String, String?]

      # The artifacts `declaration` finds, after checking that no two
      # have one name.
      def named_once: (Plugin plugin, ArtifactDeclaration declaration) -> Array[Artifact]

      # The artifacts `declaration` finds.
      def find: (Plugin plugin, ArtifactDeclaration declaration) -> Array[Artifact]

      # What each artifact in the primary piece's file at `path` matched, with the
      # line its declaration's regex matched on; for a declaration with no
      # regex, `match` alone, with no line. Raises Stopped at a used
      # capture that matched nothing.
      def primary_matches: (Plugin plugin, ArtifactDeclaration declaration, String path, Hash[String, String] match) -> Array[[Hash[String, String], Integer?]]

      # Whether `path` stays in the project: no segment is empty, `.`, or
      # `..`.
      def inside?: (String path) -> bool

      # The piece `piece` declares, for the primary piece whose placeholders
      # matched `match`.
      def piece: (Plugin plugin, ArtifactDeclaration declaration, PieceDeclaration piece, Hash[String, String] match) -> Piece

      # The text of the file at `path`, or nil when it can't be read.
      def text: (String path) -> String?

      # What the block returns, as it searches the file at `path` with
      # `regex`, the regex of `owner`. Raises Stopped when the search runs
      # past the regex's time limit or the file isn't UTF-8.
      def search: [T] (Plugin plugin, ArtifactDeclaration declaration, String owner, String path, Regex regex) { () -> T } -> T

      # A fault of `declaration`'s role in `plugin`.
      def fault: (Plugin plugin, ArtifactDeclaration declaration, String message) -> Fault
    end
  end
end
