module CrossLint
  module Core
    # Checks a loaded project: finds each artifact by its primary pattern,
    # applies each enabled policy where its condition holds, runs its
    # rules, gives each violation its severity, and returns what to
    # report under the --warnings mode and the verbosity. It reads the
    # project's files only through `project_files`, plugins' Ruby only
    # through `plugin_ruby`, and runs helpers only through `helpers`, and
    # writes nothing itself. A plugin whose Ruby rule has a fault, while
    # it loads or checks, or whose artifacts can't be told apart by name,
    # reports the fault alone, and the other plugins run. Then each step of each plugin that didn't stop runs on every
    # violation, and the result leaves out what the steps excuse and adds
    # what they report.
    class Check
      # A use case that reads the project's files through `project_files`,
      # loads plugins' Ruby through `plugin_ruby`, and runs their helpers
      # through `helpers`, and runs each plugin's steps from `steps`, by
      # name.
      def initialize: (project_files: _ProjectFiles, plugin_ruby: _PluginRuby, helpers: _Helpers, steps: Hash[String, _Step]) -> void

      # The result of checking `project`. `warnings` and `verbosity` are
      # the command line's, nil when it gives none, and the configuration's
      # or CrossLint's defaults (`:all`, `:normal`) apply then. With `all`,
      # the findings include each artifact checked that has no violation.
      # Raises Mistake for a root outside a Git working tree, for a helper
      # whose command isn't on the PATH, and for a Ruby rule whose file
      # isn't there, each before any rule runs. With `command`, a plugin's
      # name and the name of one of its commands, the plugin's steps get
      # the command's name, and the check doesn't fail for a violation or
      # a paid-off entry, since a command is not a judgment of the check.
      # Ends every helper before it returns. At the normal verbosity,
      # calls `started` with the counts of the artifacts it will check
      # once it has found them, before any rule runs or any helper starts.
      def call: (Project project, ?warnings: (:all | :none | :error)?, ?verbosity: (:normal | :quiet | :silent)?,
                 ?all: bool, ?command: [String, String]?, ?flags: Hash[String, String | true], ?started: (^(Array[[String, Integer]] kinds) -> void)?) -> CheckResult

      private

      @project_files: _ProjectFiles

      @steps: Hash[String, _Step]

      @plugin_ruby: _PluginRuby

      @helpers: _Helpers

      # The violations of every plugin that didn't stop, and each fault
      # that stopped one, with Ruby rules calling `helpers` and seeing
      # `files`, frozen, as the project's files.
      def run_plugins: (Project project, Array[[Plugin, Policy]] policies, Hash[String, Hash[String, Array[Artifact]]] kinds,
                        _RunningHelpers helpers, Array[String] files) -> [Array[Violation], Array[Fault]]

      # Each policy the configuration doesn't disable, with its plugin.
      def enabled_policies: (Project project) -> Array[[Plugin, Policy]]

      # The configuration's setting for a plugin's policy, or nil.
      def setting: (Project project, Plugin plugin, Policy policy) -> PolicySetting?

      # Each rule an enabled policy runs that is no built-in rule, loaded, by
      # its plugin's and its name: a Ruby rule, seeing `files` as the
      # project's files and reading them with `read`, or a rule a helper
      # runs. And the fault of each plugin that stopped while loading.
      def load_rules: (Array[[Plugin, Policy]] policies, _RunningHelpers helpers, Array[String] files, ^(String path) -> String read) -> [Hash[[String, String], RubyRule | HelperRule], Array[Fault]]

      # What `plugin`'s helper `name` answers `input` with. Raises
      # PluginError when the plugin declares no such helper.
      def call_helper: (_RunningHelpers helpers, Plugin plugin, String name, untyped input) -> untyped

      # The kinds of artifact an enabled policy applies to, as plugin and
      # artifact names, in the order the plugins declare them.
      def checked_kinds: (Project project, Array[[Plugin, Policy]] policies) -> Array[[String, String]]

      # The violations a policy's rules report, with the Ruby rules in
      # `rules` reading files with `read`. Raises RubyRule::Stopped at a
      # Ruby rule's fault.
      def run: (Project project, Plugin plugin, Policy policy, Hash[String, Hash[String, Array[Artifact]]] kinds,
                Hash[[String, String], RubyRule | HelperRule] rules, ^(String path) -> String read) -> Array[Violation]

      # What each step of each plugin that didn't stop at a fault does with
      # every violation.
      def run_steps: (Project project, Array[Violation] violations, Array[Fault] faults, [String, String]? command,
                       Hash[String, String | true] flags) -> Array[StepResult]

      # The result: violations the steps didn't excuse and those they add,
      # paid-off entries, notices, and passing artifacts, filtered by
      # `warnings` and `verbosity`, the summary, `faults`, and what the
      # steps wrote. A nil `warnings` is `:all`.
      def report: (Project project, Hash[String, Hash[String, Array[Artifact]]] kinds, Array[[String, String]] checked,
                   Array[Violation] violations, Array[Fault] faults, Array[StepResult] steps, warnings: (:all | :none | :error)?,
                   verbosity: (:normal | :quiet | :silent), all: bool, command: [String, String]?) -> CheckResult

      # Whether the configuration disables the policy of `violation`.
      def disabled?: (Project project, Violation violation) -> bool

      # A notice for each Ruby rule no policy runs and each artifact
      # declaration whose primary pattern matches no file.
      def notices: (Project project, Hash[String, Hash[String, Array[Artifact]]] kinds) -> Array[Notice]

      # A notice for each of `plugin`'s artifact declarations that matches
      # no file in `found`, its artifacts by declaration, leaving out the
      # optional ones; or, when none matches a file and one is optional,
      # one notice for the plugin.
      def unmatched: (Plugin plugin, Hash[String, Array[Artifact]] found) -> Array[Notice]

      # The artifacts of the checked kinds that have no violation.
      def passed: (Hash[String, Hash[String, Array[Artifact]]] kinds, Array[[String, String]] checked,
                   Array[Violation] violations) -> Array[Artifact]

      # How many artifacts of each kind in `checked` `kinds` has, named
      # PLUGIN/ARTIFACT where two plugins' kinds share a name.
      def counts: (Hash[String, Hash[String, Array[Artifact]]] kinds, Array[[String, String]] checked) -> Array[[String, Integer]]

      # The summary of the violations shown, with `hidden` true when
      # --warnings=none hides warnings.
      def summary: (Hash[String, Hash[String, Array[Artifact]]] kinds, Array[[String, String]] checked,
                    Array[Violation] shown, bool hidden, Integer faults) -> Summary

      # `findings` in the order the report gives them.
      def sort: (Array[Violation | PaidOffEntry | Artifact] findings) -> Array[Violation | PaidOffEntry | Artifact]
    end
  end
end
