module CrossLint
  module Core
    # What `crosslint update` found for one shared plugin: the plugin as
    # listed, the tag it would move to, and the newer tags it would not.
    class Update < Data
      # The shared plugin as the configuration lists it.
      attr_reader listing: ListedPlugin

      # The tag with the highest version among the repository's tags that
      # are compatible with the plugin's ref, or among all of them when
      # the update looks for the latest, such as "v1.4.0". Nil when no tag
      # is a version. The tag the plugin is at already, when it is one of
      # the tags of that version.
      attr_reader newest: String?

      # The highest tag of each group of newer versions that aren't
      # compatible with the plugin's ref, the lowest first. Empty when the
      # update looks for the latest.
      attr_reader newer: Array[String]

      # An update with these fields, `newer` empty when left out.
      def self.new: (listing: ListedPlugin, newest: String?, ?newer: Array[String]) -> instance

      # An update with these fields, `newer` empty when left out.
      def initialize: (listing: ListedPlugin, newest: String?, ?newer: Array[String]) -> void

      # Whether the plugin is at its newest tag already.
      def current?: () -> bool

      # Whether the plugin is at a version tag and no tag of its
      # repository is a version.
      def untagged?: () -> bool

      # Whether the plugin's ref is no plain version tag, vX.Y.Z or X.Y.Z:
      # a prerelease tag, a branch, or a commit SHA. Update leaves it
      # alone, and never asks for its repository's tags.
      def pinned?: () -> bool
    end

    # What `crosslint update` found for every shared plugin the
    # configuration lists.
    #
    # ```ruby
    # listing = CrossLint::Core::ListedPlugin.new(name: "https://github.com/OWNER/REPO", ref: "v1.0.0", settings: [], line: 1)
    # update = CrossLint::Core::Update.new(listing:, newest: "v1.2.0")
    # result = CrossLint::Core::UpdateResult.new(updates: [update], dry_run: true)
    # result.lines # => ["https://github.com/OWNER/REPO: would move from v1.0.0 to v1.2.0"]
    # ```
    class UpdateResult < Data
      # One for each shared plugin, in the order the configuration lists
      # them.
      attr_reader updates: Array[Update]

      # Whether the update only listed what it would change.
      attr_reader dry_run: bool

      # A result with these fields.
      def self.new: (updates: Array[Update], dry_run: bool) -> instance

      # A result with these fields.
      def initialize: (updates: Array[Update], dry_run: bool) -> void

      # The updates that move a plugin to another tag.
      def changes: () -> Array[Update]

      # One line for each update: the plugin and its URL, and what
      # moved, would move, or stays, and the newer incompatible versions,
      # with the one `crosslint update --latest` would move to.
      def lines: () -> Array[String]

      private

      # What the update did to its plugin, or why it did nothing.
      def what: (Update update) -> String

      # What the update says of the newer incompatible versions it left,
      # or an empty string when there are none.
      def newer: (Update update) -> String
    end

    # Moves each shared plugin the configuration lists, whose ref is a
    # version tag, to the newest tag of its repository that is a version,
    # vX.Y.Z or X.Y.Z, and compatible with its ref, by rewriting its ref
    # in the configuration, and never to a lower version than its ref's.
    # With `latest`, the newest tag is the highest version even when it isn't
    # compatible; without it, the lines name the newer versions that
    # aren't compatible. A plugin whose ref is no version tag, a
    # prerelease tag or a commit SHA among them, or whose repository has
    # no such tag, stays as it is. Local and built-in plugins are left
    # alone. It raises Mistake, naming the file and the
    # line, when a shared plugin has no ref or its tags can't be listed,
    # and changes nothing then.
    class UpdatePlugins
      # A use case that reads the configuration and sets refs through
      # `configuration`, and lists tags through `shared_plugins`, for the
      # CrossLint whose version is `crosslint`: a configuration that names
      # a newer one as the oldest that reads it stops the update with a
      # Mistake that names both, before any request.
      def initialize: (configuration: _Configuration, shared_plugins: _SharedPlugins, crosslint: Version) -> void

      # Updates the project whose root is `start` or the nearest folder
      # above it with a configuration. With `dry_run`, changes nothing.
      def call: (String start, ?dry_run: bool, ?latest: bool) -> UpdateResult

      private

      @configuration: _Configuration

      @shared_plugins: _SharedPlugins

      @crosslint: Version

      # The tag each of `changes` moves its plugin to, by the plugin's URL
      # and path.
      def refs: (Array[Update] changes) -> Hash[[String, String?], String]

      # The update of the shared plugin `listing`, listed in `file`.
      # `tags` holds the tags listed so far, by URL.
      def update: (ListedPlugin listing, String file, Hash[String, Array[String]] tags, bool latest) -> Update
    end
  end
end
