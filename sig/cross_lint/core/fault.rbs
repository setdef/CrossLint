module CrossLint
  module Core
    # An error in a plugin's code whose message says what the code did,
    # as the rest of a fault's line: "returned nil from check, where
    # check returns an array of violations".
    class PluginError < StandardError
    end

    # What stopped a plugin: its name, the rule that was loading or
    # running or the role whose artifacts CrossLint was finding, the
    # artifact it was checking, if any, what went wrong, and the trace,
    # which the report shows under --debug.
    #
    # ```ruby
    # fault = CrossLint::Core::Fault.new(plugin: "tests", rule: "names-class", artifact: "lib/a.rb",
    #   message: "raised RuntimeError: boom", trace: [])
    # fault.line # => "fault in plugin tests: rule names-class on lib/a.rb raised RuntimeError: boom"
    # ```
    class Fault < Data
      # The name of the plugin that stopped.
      attr_reader plugin: String

      # The name of the rule, or nil for a fault in finding artifacts.
      attr_reader rule: String?

      # The role whose artifacts CrossLint was finding, or nil for a fault
      # in a rule.
      attr_reader role: String?

      # Where the artifact the rule was checking is, its primary piece's path and,
      # for one a regex found, its line, or nil when the rule was loading.
      attr_reader artifact: String?

      # What the rule did, as a verb phrase, such as "raised
      # RuntimeError: boom".
      attr_reader message: String

      # Where the error was raised, innermost first.
      attr_reader trace: Array[String]

      # The fault for `error`, which `rule` of `plugin` raised while it
      # loaded, or while it checked `artifact`.
      def self.of: (Exception error, plugin: Plugin, rule: String, ?artifact: String?) -> Fault

      # What the code did, from `error`. For a require of a feature by
      # name that Ruby can't find, such as a gem's: that the feature is in
      # neither Ruby's standard library nor the plugin's folder (`folder`),
      # and that CrossLint can't load a gem it wasn't built with.
      #
      # ```ruby
      # error = LoadError.new("cannot load such file -- rainbow")
      # def error.path = "rainbow"
      # CrossLint::Core::Fault.describe(error, "/p") # => "requires rainbow, which is neither in Ruby's standard library nor in the plugin's folder, and CrossLint can load no gem it wasn't built with"
      # ```
      def self.describe: (Exception error, String folder) -> String

      # What a LoadError says the code did.
      def self.loading: (LoadError error, String folder) -> String

      # A fault with these fields, of a rule or a role.
      def self.new: (plugin: String, ?rule: String?, artifact: String?, message: String, trace: Array[String], ?role: String?) -> instance

      # A fault with these fields, as for `new`.
      def initialize: (plugin: String, ?rule: String?, artifact: String?, message: String, trace: Array[String], ?role: String?) -> void

      # The fault as one line: the plugin, the rule or the role, the
      # artifact, and the message.
      #
      # ```ruby
      # fault = CrossLint::Core::Fault.new(plugin: "tests", role: "ruby-file", artifact: nil,
      #   message: "has two artifacts named card, src/a/card.rb and src/b/card.rb", trace: [])
      # fault.line # => "fault in plugin tests: artifact ruby-file has two artifacts named card, src/a/card.rb and src/b/card.rb"
      # ```
      def line: () -> String
    end
  end
end
