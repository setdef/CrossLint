module CrossLint
  module Core
    # A path pattern, such as `lib/{path}.rb`: a path, with `/` on every
    # system, and placeholders in braces. In an artifact's `primary`,
    # `{path}` matches a file name and the folders before it, if any, and
    # `{name}` one segment of a path; in a piece's path, each stands
    # for what it matched.
    #
    # ```ruby
    # CrossLint::Core::PathPattern.new(source: "test/{path}_{name}.rb").placeholders # => ["path", "name"]
    # ```
    class PathPattern < Data
      # The placeholders a pattern can have.
      PLACEHOLDERS: Array[String]

      # A placeholder in a pattern's source.
      PLACEHOLDER: Regexp

      # A pattern that isn't one, with a message that says why.
      class Invalid < ArgumentError
      end

      # The pattern as written.
      attr_reader source: String

      # The names of its artifact's primary regex's captures, which it
      # may use as placeholders beside PLACEHOLDERS, in a piece's pattern
      # or a name.
      attr_reader captures: Array[String]

      # What makes `source` no pattern, or nil when it is one: it is empty,
      # has a `\`, has a placeholder that isn't one of `known`,
      # PLACEHOLDERS unless given, or has a brace that pairs with nothing.
      #
      # ```ruby
      # CrossLint::Core::PathPattern.problem("lib/{path}.rb") # => nil
      # CrossLint::Core::PathPattern.problem("lib/{path.rb") # => "path pattern \"lib/{path.rb\" has a { that pairs with nothing"
      # ```
      def self.problem: (String source, ?Array[String] known) -> String?

      # The pattern `source`, as an artifact named `artifact` declares it
      # in a helper's Ruby, which may pass anything. Raises PluginError,
      # naming the artifact, unless `source` is a string that is a
      # pattern. A class method, so a plugin's subclass of
      # CrossLint::Artifacts can't replace it by defining a method.
      def self.declared: (String artifact, untyped source) -> instance

      # The pattern `source`, which may also use `captures` as
      # placeholders. Raises Invalid with its problem when it has one.
      def self.new: (source: String, ?captures: Array[String]) -> instance

      # The pattern `source`, as for `new`.
      def initialize: (source: String, ?captures: Array[String]) -> void

      # The names of the placeholders in the pattern, each once, in the
      # order they first appear.
      def placeholders: () -> Array[String]

      # What each placeholder matches, as a regular expression, by name.
      MATCHES: Hash[String, String]

      # The text each placeholder matched in `path`, by name, or nil when
      # the pattern doesn't match `path`. The match is case-sensitive, and
      # the rest of the pattern matches only itself: a path pattern is not
      # a glob. A placeholder written twice matches the same text both
      # times. Where the pattern could match in several ways, the first
      # placeholder takes as much as it can.
      #
      # ```ruby
      # pattern = CrossLint::Core::PathPattern.new(source: "lib/{path}.rb")
      # pattern.match("lib/fledge/archive.rb") # => {"path" => "fledge/archive"}
      # pattern.match("lib/fledge.rb") # => {"path" => "fledge"}
      # pattern.match("sig/fledge.rbs") # => nil
      # ```
      def match: (String path) -> Hash[String, String]?

      # The path the pattern gives for `values`, the text of each of its
      # placeholders, as `match` returns them.
      #
      # ```ruby
      # CrossLint::Core::PathPattern.new(source: "sig/{path}.rbs").expand({"path" => "fledge/archive"})
      # # => "sig/fledge/archive.rbs"
      # ```
      def expand: (Hash[String, String] values) -> String

      private

      # The regular expression that matches the paths the pattern matches.
      def regexp: () -> Regexp
    end
  end
end
