module CrossLint
  module Core
    # A policy's condition, after `when`: which of the artifacts it
    # applies to it checks.
    type condition = Condition::PieceExists | Condition::Not | Condition::All | Condition::Any

    # The conditions a policy's `when` can state.
    module Condition
      # Holds when the artifact's piece of this name exists.
      class PieceExists < Data
        # The piece's name.
        attr_reader piece: String

        # The line the condition is on.
        attr_reader line: Integer

        # A condition on the piece `piece`, on `line`.
        def self.new: (piece: String, line: Integer) -> instance

        # A condition on the piece `piece`, on `line`.
        def initialize: (piece: String, line: Integer) -> void

        # Itself, the one piece-exists condition it holds.
        def piece_conditions: () -> Array[PieceExists]

        # Whether `artifact`'s piece of this name exists.
        def holds?: (Artifact artifact) -> bool

        # The condition as the debug output says it for `artifact`: as
        # written after `when`, with whether the piece exists, as in
        # `piece-exists "stub" (missing)`.
        def explanation: (Artifact artifact) -> String
      end

      # Holds when the condition inside doesn't.
      class Not < Data
        # The condition inside.
        attr_reader condition: Core::condition

        # The line `not` is on.
        attr_reader line: Integer

        # The opposite of `condition`, on `line`.
        def self.new: (condition: Core::condition, line: Integer) -> instance

        # The opposite of `condition`, on `line`.
        def initialize: (condition: Core::condition, line: Integer) -> void

        # The piece-exists conditions the condition inside holds.
        def piece_conditions: () -> Array[PieceExists]

        # Whether the condition inside doesn't hold for `artifact`.
        def holds?: (Artifact artifact) -> bool

        # `not { ... }`, around the explanation of the condition inside.
        def explanation: (Artifact artifact) -> String
      end

      # A condition on the conditions inside it, `all` or `any`.
      class Group < Data
        # The conditions inside, one or more.
        attr_reader conditions: Array[Core::condition]

        # The line the condition is on.
        attr_reader line: Integer

        # A condition on `conditions`, on `line`.
        def self.new: (conditions: Array[Core::condition], line: Integer) -> instance

        # A condition on `conditions`, on `line`.
        def initialize: (conditions: Array[Core::condition], line: Integer) -> void

        # The piece-exists conditions the conditions inside hold.
        def piece_conditions: () -> Array[PieceExists]

        # The word the condition is written with, as in `all { ... }`.
        def keyword: () -> String

        # The keyword's block, around the explanations of the conditions
        # inside.
        def explanation: (Artifact artifact) -> String
      end

      # Holds when every condition inside does.
      class All < Group
        # `all`.
        def keyword: () -> String

        # Whether every condition inside holds for `artifact`.
        def holds?: (Artifact artifact) -> bool
      end

      # Holds when at least one condition inside does.
      class Any < Group
        # `any`.
        def keyword: () -> String

        # Whether at least one condition inside holds for `artifact`.
        def holds?: (Artifact artifact) -> bool
      end
    end
  end
end
