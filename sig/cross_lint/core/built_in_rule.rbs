module CrossLint
  module Core
    # A rule built into CrossLint, which any policy can run: its name, the
    # arguments it takes, and the severity of its violations.
    #
    # ```ruby
    # CrossLint::Core::BuiltInRule.named("piece-exists").arguments # => ["piece"]
    # ```
    class BuiltInRule < Data
      # Every built-in rule.
      ALL: Array[BuiltInRule]

      # The rule's name, such as "piece-exists".
      attr_reader name: String

      # The arguments the rule takes, each of them needed.
      attr_reader arguments: Array[String]

      # The severity of the rule's violations, unless a policy gives
      # another.
      attr_reader severity: severity

      # What the rule reports on `artifact` with `arguments`, its messages
      # as results, each with the name of the piece the rule checked as its
      # detail; it reads no file, so it leaves `read` alone.
      def results: (Artifact artifact, Hash[String, untyped] arguments, ^(String path) -> String read) -> Array[RuleResult]

      # The built-in rule called `name`, or nil.
      def self.named: (String name) -> BuiltInRule?

      # The messages of the violations the rule reports for `artifact`,
      # given a policy's `arguments`: for piece-exists, one when the
      # piece doesn't exist; for piece-absent, one when it does.
      #
      # ```ruby
      # piece = CrossLint::Core::Piece.new(name: "test", path: "test/a_test.rb", exists: false)
      # artifact = CrossLint::Core::Artifact.new(plugin: "tests", role: "ruby-file", path: "lib/a.rb",
      #   match: {"path" => "a"}, pieces: [piece])
      # CrossLint::Core::BuiltInRule.named("piece-exists").messages(artifact, {"piece" => "test"})
      # # => ["no test file at test/a_test.rb"]
      # ```
      def messages: (Artifact artifact, Hash[String, untyped] arguments) -> Array[String]

      # What a violation of the rule says about `piece`: its path, and for
      # a piece with a regex, the line of its first match, or whether its
      # file has no match or isn't a file.
      def message: (Piece piece) -> String

      # A built-in rule with these fields.
      def self.new: (name: String, arguments: Array[String], severity: severity) -> instance

      # A built-in rule with these fields.
      def initialize: (name: String, arguments: Array[String], severity: severity) -> void
    end
  end
end
