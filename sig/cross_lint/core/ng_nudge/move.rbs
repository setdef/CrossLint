module CrossLint
  module Core
    module NgNudge
      # What `crosslint init --from-ng-nudge` did, or would do.
      class MoveResult < Data
        # Each change, as a verb and what it acts on, such as "write
        # .config/crosslint/config.kdl, with the plugins angular and debt".
        attr_reader changes: Array[String]

        # Each file that node-glob finds for a role and CrossLint doesn't,
        # or the other way round, and why they weren't compared when they
        # weren't. None of them stops the move.
        attr_reader notes: Array[String]

        # Whether it only listed the changes.
        attr_reader dry_run: bool

        # A result with these fields.
        def self.new: (changes: Array[String], notes: Array[String], dry_run: bool) -> instance

        # A result with these fields.
        def initialize: (changes: Array[String], notes: Array[String], dry_run: bool) -> void
      end

      # Moves a project from ng-nudge 0.3.0: writes the configuration its
      # rc.json converts to (Rc), and moves its debt file to
      # `.config/crosslint/debt.tsv` as it is. Every key is checked, the
      # debt file read, and the regular expression of `withComment.matching`
      # tested by JavaScript and by its translation on each comment, before
      # any change, and each change is listed to `planned` before the
      # first. It raises Mistake, naming the file and the key, for
      # anything it can't carry, and for a configuration or a debt file it
      # would replace, unless it is told to; for more than one, it raises
      # Mistakes, listing every one. It also compares the files the
      # project's own node-glob finds for each role's pattern with the files
      # CrossLint finds, and lists each that only one of them finds as a
      # note, which stops nothing.
      class Move
        # The folders, relative to the project's root, that the glob
        # package ng-nudge finds its files with is looked for from.
        PACKAGES: Array[String]

        # What a project with no rc.json is moved as if it held.
        EMPTY: String

        # What node-glob does that CrossLint doesn't.
        WHY: String

        # A use case that reads rc.json and the extension files through
        # `ng_nudge`, writes the configuration through `configuration`,
        # reads and moves the debt file through `debt_files`, tests
        # expressions and finds files through `javascript`, and lists the
        # files CrossLint finds through `project_files`.
        def initialize: (configuration: _Configuration, ng_nudge: _NgNudge, debt_files: _DebtFiles, javascript: _JavaScript, project_files: _ProjectFiles) -> void

        # Moves the project whose root is `root`. With `force`, replaces
        # a configuration and a debt file that are there; with `dry_run`,
        # changes nothing. `planned` is called with the changes and the
        # notes before the first change is made.
        def call: (String root, ?force: bool, ?dry_run: bool, ?planned: (^(Array[String], Array[String]) -> void)?) -> MoveResult

        private

        @configuration: _Configuration

        @ng_nudge: _NgNudge

        @debt_files: _DebtFiles

        @javascript: _JavaScript

        @project_files: _ProjectFiles

        # The line that says a project with no rc.json, whose `text` is
        # nil, is moved as if it held `{}`, or none when it has one.
        def assumed: (String? text) -> Array[String]

        # A line for each file only node-glob or only CrossLint finds for a
        # role of `converted`, with why, or why they weren't compared.
        def compare: (String root, Rc::Result converted) -> Array[String]

        # Raises a Mistake that says `what`, a file CrossLint would write,
        # is there already.
        def refuse_existing: (String file, String what) -> bot

        # What the block gives, or nil after adding the Mistake or Mistakes
        # it raised to `problems`.
        def attempt: [T] (Array[Mistake] problems) { () -> T } -> T?

        # A Mistake for each file of artifacts or policies in `paths`,
        # which change what ng-nudge checks.
        def code_files: (Array[String] paths) -> Array[Mistake]

        # A line for each setting the configuration holds, in the order the
        # file holds them: the settings of each plugin, and of a role in it,
        # then the policy lines, then the modes.
        def settings: (Configuration configuration) -> Array[String]

        # The line for a setting, and for each setting inside it, saying
        # where it is.
        def setting_lines: (Setting setting, String within) -> Array[String]

        def kdl: (untyped value) -> String

        # The lines for the configuration written, and the debt file
        # moved, if there is one.
        def moved: (bool replaced, Rc::Result converted, bool moves, DebtFile debt, bool replaces) -> Array[String]

        # Raises a Mistake when JavaScript refuses `matching`, or when it
        # and the translation of
        # `matching` don't agree on a comment of `debt`, which is nil when
        # it can't be read.
        def agree: (Matching matching, DebtFile? debt) -> void
      end
    end
  end
end
