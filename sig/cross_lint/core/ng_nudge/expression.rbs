module CrossLint
  module Core
    module NgNudge
      # A JavaScript regular expression from ng-nudge's rc.json, as the Ruby
      # regular expression with the same meaning, tested anywhere in the
      # text as ng-nudge's `RegExp#test` does.
      #
      # `^` and `$` become `\A` and `\z`; `.` becomes a class of anything
      # but JavaScript's line terminators; `\s` and `\S` become
      # JavaScript's white space; `\b` and `\B` become boundaries of ASCII
      # word characters; `\xHH` becomes `\uHHHH`; and a backreference by
      # number becomes `\k<N>`. Literals, `\d`, `\w`, `\n`, `\t`, groups,
      # named groups, lookahead, lookbehind, simple classes, and
      # quantifiers stay as they are. Everything else is refused, such as
      # `\p`, `\h`, `\A`, POSIX classes, `[]`, `[^]`, a backreference to a
      # group not yet defined, and a possessive quantifier. The caller
      # tests the two expressions against the same texts, since a
      # difference in what they match is the last thing the translation
      # can't rule out.
      #
      # ```ruby
      # CrossLint::Core::NgNudge::Expression.translate("^TODO\\b") # => "\\ATODO(?:(?<![A-Za-z0-9_])(?=[A-Za-z0-9_])|(?<=[A-Za-z0-9_])(?![A-Za-z0-9_]))"
      # ```
      class Expression
        # The reason an expression isn't translated.
        class Unsupported < ArgumentError
        end

        # The code points from `first` to `last`, both included.
        class Span < Data
          # The first code point.
          attr_reader first: Integer

          # The last code point.
          attr_reader last: Integer

          # A span with these fields.
          def self.new: (first: Integer, last: Integer) -> instance

          # A span with these fields.
          def initialize: (first: Integer, last: Integer) -> void
        end

        # What a class member stands for.
        class Member < Data
          # The Ruby text that says it.
          attr_reader text: String

          # The code points it holds.
          attr_reader spans: Array[Span]

          # Its code point when it is one character, else nil.
          attr_reader code: Integer?

          # The text of the source it came from.
          attr_reader source: String

          # A member with these fields.
          def self.new: (text: String, spans: Array[Span], code: Integer?, source: String) -> instance

          # A member with these fields.
          def initialize: (text: String, spans: Array[Span], code: Integer?, source: String) -> void
        end

        # `code` as `\uHHHH`, or `\u{H...}` above U+FFFF.
        def self.written: (Integer code) -> String

        # The contents of a class for the code points, and ranges of
        # code points, in `codes`, each written as `\uHHHH`.
        def self.escapes: (Array[Integer | Range[Integer]] codes) -> String

        # The spans of the code points, and ranges of code points, in
        # `codes`.
        def self.spans: (Array[Integer | Range[Integer]] codes) -> Array[Span]

        # The code points that no span of `taken` has, as spans, leaving out
        # the surrogates, which no Ruby text holds.
        def self.complement: (Array[Span] taken) -> Array[Span]

        # What JavaScript's `\s` is, as code points and ranges of them.
        SPACE_CODES: Array[Integer | Range[Integer]]

        # What JavaScript's `\s` stands for, as the contents of a class.
        SPACE: String

        # What JavaScript's `\s` holds.
        SPACE_SPANS: Array[Span]

        # What JavaScript's `\S` holds.
        NOT_SPACE_SPANS: Array[Span]

        # What JavaScript's `\d` holds.
        DIGIT_SPANS: Array[Span]

        # What JavaScript's `\w` holds.
        WORD_SPANS: Array[Span]

        # What each escape that stands for a set of characters holds.
        SETS: Hash[String, Array[Span]]

        # What JavaScript's `.` leaves out, as the contents of a class.
        LINE_END: String

        # The characters of JavaScript's `\w`, as the contents of a class.
        WORD: String

        # JavaScript's `\b`, as a Ruby expression.
        BOUNDARY: String

        # JavaScript's `\B`, as a Ruby expression.
        NOT_BOUNDARY: String

        # The characters a backslash before them makes stand for themselves.
        LITERAL: String

        # What can follow a `(` for a group that doesn't capture.
        LOOKAROUND: Array[String]

        # `{n}`, `{n,}`, and `{n,m}`, where JavaScript and Ruby agree.
        QUANTIFIER: Regexp

        # A name of a group that both read the same.
        NAME: Regexp

        # The Ruby expression for `source`, a JavaScript expression with no
        # flags, as source text. Raises Unsupported, with the reason, for
        # every form it doesn't translate.
        def self.translate: (String source) -> String

        # A translation of `source`.
        def initialize: (String source) -> void

        # The Ruby expression as source text. Raises Unsupported.
        def translated: () -> String

        private

        @source: String

        @out: String

        @at: Integer

        @open: Array[Array[String]]

        @groups: Integer

        @closed: Array[String]

        @named: bool

        @quantified: bool?

        # Raises Unsupported with `message`.
        def refuse: (String message) -> bot

        # The source from the character at `from` on.
        def rest: (Integer from) -> String

        # Reads one character of the source, and what follows it that it
        # starts.
        def step: () -> void

        # Writes `text`, which a quantifier can follow.
        def atom: (String text) -> String

        # Writes the quantifier `text`, and the `?` after it that makes it
        # lazy.
        def quantifier: (String text) -> void

        # Reads the `{n,m}` that follows a `{`.
        def braces: () -> void

        # Reads what follows a `(`: a group, a lookaround, or a named
        # group.
        def open: () -> String

        # Writes the `(` of a capturing group, numbered, with its `name`.
        def capture: (Array[String] names, String text) -> String

        # Writes a `)`, and notes the group it closes as defined.
        def close: () -> String

        # Reads the escape that follows a backslash, inside a class or not.
        def escape: (inside: bool) -> String

        # The text for the escape that follows a backslash, which `escape`
        # writes.
        def escaped: (inside: bool) -> String

        # `\k<name>` or `\N`, which a class can't have.
        def back_reference: (String char, bool inside) -> String

        # `\b` or `\B`, which a class can't have.
        def boundary: (String char, bool inside) -> String

        # The `\uHHHH` for `size` hexadecimal digits that follow `\x` or
        # `\u`.
        def hex: (Integer size) -> String

        # The `\k<N>` for the backreference by number that the escape just
        # read starts, with every digit of N.
        def reference: () -> String

        # The `\k<name>` for a backreference by name.
        def named_reference: () -> String

        # Reads a class, from the characters after its `[`.
        def set: () -> String

        # The member of a class that `char`, the character just read,
        # stands for.
        def member: (String char) -> Member

        # The member a backslash in a class stands for.
        def class_escape: () -> Member

        # `members`, with each `a-b` made one member. Raises Unsupported for
        # a range that ends before it starts.
        def ranged: (Array[Member] members) -> Array[Member]

        # What goes between `[` and `]` for `members`: their text as it is,
        # or, when two of them hold a code point, each code point they hold
        # written once.
        def contents: (Array[Member] members) -> String
      end
    end
  end
end
