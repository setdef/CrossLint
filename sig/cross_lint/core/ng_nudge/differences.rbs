module CrossLint
  module Core
    module NgNudge
      # What node-glob finds for a role's pattern, and what the Angular
      # plugin finds with the path pattern it was converted to, compared:
      # each file only one of them finds is a line to say. node-glob and
      # CrossLint differ in ways that aren't about the pattern: node-glob
      # ignores case on macOS and Windows, returns folders, finds files
      # Git ignores, and follows a symlinked folder.
      #
      # ```ruby
      # files = ["src/app/a.store.ts", "src/.hidden/b.store.ts", "lib/c.store.ts"]
      # CrossLint::Core::NgNudge::Differences.found(files, "src", "{path}.store.ts") # => ["app/a.store.ts"]
      # ```
      class Differences
        # The paths, relative to `src_dir`, of the `files` of the project
        # that the Angular plugin finds for the path pattern `pattern`,
        # which is relative to `src_dir`: a file below a folder, or a file,
        # whose name starts with a dot is skipped where a placeholder
        # matches it.
        def self.found: (Array[String] files, String src_dir, String pattern) -> Array[String]

        # A comparison for the role `role`, found in `src_dir`.
        def initialize: (role: String, src_dir: String) -> void

        # A line for each file only one of the two finds, those only
        # node-glob finds first, each in the order of its path. The paths
        # are relative to `src_dir`.
        def lines: (Array[String] glob_found, Array[String] crosslint_found) -> Array[String]

        private

        @role: String

        @src_dir: String

        # `path`, relative to `src_dir`, as a path relative to the project's root.
        def named: (String path) -> String
      end
    end
  end
end
