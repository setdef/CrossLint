module CrossLint
  module Core
    # Finds a project's root, reads its configuration and the manifest of
    # every plugin it lists, and checks them against each other, all before
    # CrossLint looks at any other file. It raises Mistake at the first
    # mistake, naming the file and the line, and the nearest valid
    # spelling where one is close.
    class LoadProject
      # The name of the class a plugin's artifacts file defines.
      DECLARER: Symbol

      # What the name of a plugin's command is made of.
      COMMAND: Regexp

      # The names CrossLint keeps for commands it may add, which no plugin
      # that adds commands can have, besides the names of the commands it
      # has.
      RESERVED: Array[String]

      # A use case that reads through `configuration` and `manifests`, runs
      # the Ruby that declares a plugin's artifacts through `plugin_ruby`,
      # and fetches shared plugins through `shared_plugins`. `built_in` has
      # the folder of each built-in plugin, by name, and `steps` each step
      # CrossLint has, by name. `reserved` has the name of each command of
      # CrossLint, which no plugin that adds commands can be named.
      def initialize: (configuration: _Configuration, manifests: _PluginManifests, plugin_ruby: _PluginRuby, shared_plugins: _SharedPlugins,
                       ?built_in: Hash[String, String], ?steps: Hash[String, _Step], ?reserved: Array[String]) -> void

      # The project whose root is `start` or the nearest folder above it
      # with a configuration.
      def call: (String start) -> Project

      # The plugins the configuration at `start`, or the nearest folder
      # above it with one, lists, whose manifests are on disk. It fetches
      # nothing: a shared plugin not in the cache is in `unfetched`, and
      # no plugin's Ruby runs, no plugin is checked against another, and a
      # configuration that lists no plugin is no mistake. Raises Mistake
      # for a configuration or a manifest it can't read, as `call` does.
      def listed: (String start) -> PluginListing

      private

      @configuration: _Configuration

      @manifests: _PluginManifests

      @shared_plugins: _SharedPlugins

      @built_in: Hash[String, String]

      @steps: Hash[String, _Step]

      @reserved: Array[String]

      # The plugin listed at `index`, with its manifest, checked against
      # the plugins `loaded` before it. A local or shared plugin can't have
      # the name of a built-in one. Without `fetching`, nil for a shared
      # plugin not in the cache.
      def plugin: (String root, Configuration configuration, Integer index, Array[Plugin] loaded, ?fetching: bool) -> Plugin?

      # What a message calls the place `listing`'s manifest should be in,
      # `folder` for a plugin in a folder.
      def where: (ListedPlugin listing, String folder) -> String

      # The folder the listed plugin is in, as a base folder and a path
      # relative to it, or nil for a shared plugin not in the cache when
      # `fetching` is false.
      def place: (String root, ListedPlugin listing, ^(String message, ?Integer line) -> bot fail_at, bool fetching) -> [String, String]?

      # The cache folder of the shared plugin `listing`, as a base folder
      # and an empty path from it. With `fetching`, fetches the plugin the
      # first time; without, nil for a plugin not in the cache. Fails at the
      # listing when it has no ref, can't be named, or can't be fetched.
      def fetch: (ListedPlugin listing, ^(String message, ?Integer line) -> bot fail_at, bool fetching) -> [String, String]?

      # A local plugin's path with no `.`, no `..` that can go, and no
      # empty segment, such as "x" for "./a/../x/".
      def clean: (String name) -> String

      # `plugin`, with the artifacts its Ruby declares from its settings
      # added to its manifest's when it has `artifacts ruby=`. `file` is
      # the configuration's.
      def declare: (Plugin plugin, String file) -> Plugin

      # `plugin` with the artifacts `ruby` declares. Raises Mistake at
      # whatever the Ruby raises.
      def declare_in_ruby: (Plugin plugin, ArtifactsRuby ruby, String file) -> Plugin

      # Checks that a plugin's manifest declares each name once, and
      # agrees with itself and with the other plugins.
      def check_manifest: (Plugin plugin, Array[Plugin] plugins) -> void

      # Checks that each of an artifact's companions has its name once
      # and only placeholders its files pattern has.
      def check_artifact: (ArtifactDeclaration artifact, String file) -> void

      # Checks that no two of `declarations` have the same name.
      def once: (Array[ArtifactDeclaration | CompanionDeclaration | RuleDeclaration | HelperDeclaration | Policy | StepPolicy |
                       SettingDeclaration | CommandDeclaration | StepDeclaration] declarations,
                 String kind, String file) -> void

      # Checks that the plugin's commands have names that CrossLint reads
      # as a word and none of its own, that the plugin has a name no
      # command of CrossLint's has, or a name CrossLint reserves
      # (`RESERVED`), and that it declares a step to do its
      # commands' work. Raises Mistake at the first command that breaks
      # one.
      def check_commands: (Plugin plugin) -> void

      # Checks that `command`, declared in the manifest at `file`, is
      # named by lowercase letters, digits, and -, and isn't "help".
      def check_command: (CommandDeclaration command, String file) -> void

      # Checks that each step is one CrossLint has, that each policy it
      # reports is declared with no block, and that each policy declared
      # with no block is one a step reports.
      def check_steps: (Manifest manifest) -> void

      # Checks that each setting in a plugin's block in the configuration
      # at `file` is one its manifest declares.
      def check_setting_names: (Plugin plugin, String file) -> void

      # Checks that each of a plugin's steps can read the settings in its
      # block in the configuration at `file`.
      def check_settings: (Plugin plugin, String file) -> void

      # Checks a policy's artifact, condition, and rules.
      def check_policy: (Plugin plugin, Policy policy, Array[Plugin] plugins) -> void

      # The artifact a policy applies to.
      def target: (Plugin plugin, AppliesTo applies_to, Array[Plugin] plugins) -> ArtifactDeclaration

      # Checks that a policy's rule exists and has the arguments it takes,
      # and, given `artifact`, that the artifact has the companion it
      # names.
      def check_rule: (Plugin plugin, ArtifactDeclaration? artifact, PolicyRule rule) -> void

      # Checks that `artifact` has a companion called `name`.
      def companion: (ArtifactDeclaration artifact, String name, String file, Integer line) -> void

      # Checks that each policy the configuration changes is a listed
      # plugin's, and is changed once.
      def check_policy_settings: (Configuration configuration, Array[Plugin] plugins) -> void
    end
  end
end
