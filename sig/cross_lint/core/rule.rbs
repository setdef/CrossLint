module CrossLint
  # The class a Ruby rule inherits from: a rule whose helper runs on the
  # Ruby CrossLint carries. A plugin declares the helper as
  # `helper NAME command=(crosslint)"ruby" file=FILE` and the rule as
  # `rule RULE helper=NAME`. `FILE`, relative to the plugin's folder,
  # defines one class for each rule that names the helper, named after the
  # rule in camel case, such as `SignatureNamesClass` for
  # "signature-names-class", with a `check` method. CrossLint defines
  # CrossLint::Rule before it runs the file, so the file requires nothing
  # to use it, and makes one instance of the class for each check, with no
  # arguments, so the instance can keep what it learns from one artifact
  # for the next.
  #
  # The file runs in CrossLint's process, on the Ruby CrossLint carries.
  # It can require Ruby's standard library and files in its plugin's
  # folder, and no gem CrossLint wasn't built with; bundler/inline is
  # refused. Anything the file or `check` raises is a fault that stops the
  # plugin, and the other plugins run.
  #
  # ```ruby
  # class TestNamesItsFile < CrossLint::Rule
  #   def check(artifact)
  #     test = artifact.piece("test")
  #     return [] if !test.exist? || test.read.include?(artifact.path)
  #
  #     [violation(artifact, "#{test.path} doesn't name #{artifact.path}")]
  #   end
  # end
  # ```
  class Rule
    # The folder Ruby finds `bundler/inline` in before Bundler's: its
    # `bundler/inline.rb` raises Core::PluginError.
    REFUSED: String

    # One of an artifact's pieces, as a rule sees it.
    class Piece
      # The piece's name, as its artifact declares it, such as "test".
      attr_reader name: String

      # The piece's path, relative to the project's root, with `/`.
      attr_reader path: String

      # A view of `piece` that reads files with `read`.
      def initialize: (Core::Piece piece, ^(String path) -> String read) -> void

      # Whether a file or folder exists at `path`, by its exact name.
      def exist?: () -> bool

      # The piece's text, its bytes as UTF-8. Raises Errno::ENOENT when
      # it doesn't exist.
      def read: () -> String

      private

      @exists: bool

      @read: ^(String path) -> String
    end

    # The artifact a rule checks: its primary piece's path and its pieces.
    class Artifact
      # The artifact's role: its declaration's name, such as "ruby-file".
      attr_reader role: String

      # The primary piece's path, relative to the project's root, with `/`.
      attr_reader path: String

      # The text each placeholder of the primary pattern matched in `path`,
      # by name, such as `{"path" => "fledge/archive"}`; frozen.
      attr_reader match: Hash[String, String]

      # A view of `artifact` that reads files with `read`.
      def initialize: (Core::Artifact artifact, ^(String path) -> String read) -> void

      # The piece called `name`. Raises KeyError when the artifact's
      # declaration has none of that name.
      def piece: (String name) -> Piece

      # The text of the primary piece's file, its bytes as UTF-8.
      def read: () -> String

      private

      @pieces: Array[Piece]

      @read: ^(String path) -> String
    end

    # The rule's violations on `artifact`, each made with `violation`, or
    # none. A rule's class defines it; this one raises Core::PluginError,
    # which stops the plugin.
    def check: (Artifact artifact) -> Array[Core::RuleResult]

    # The plugin's helper `name`, as something whose `call(input)` sends
    # `input` to the helper as JSON and returns the JSON it answers with.
    # The helper starts at the first call, and runs until the check ends.
    # A helper the plugin doesn't declare, or one that fails, raises
    # Core::PluginError, which stops the plugin unless the rule rescues
    # it.
    def helper: (String name) -> ^(untyped input) -> untyped

    # The project's files, among which CrossLint found the artifacts: the
    # files Git tracks, and the untracked files it doesn't ignore, with
    # nothing under `.git/`. Each is a path relative to the project's
    # root, with `/` between folders, in no particular order. The array
    # and its strings are frozen, and are the same for every artifact of
    # the check, so a rule can index them once, in `initialize` or at its
    # first artifact. For a rule that checks a path its artifact's text
    # names, such as a link's target, which no piece can give.
    def project_files: () -> Array[String]

    # The text of the file at `path`, relative to the project's root with
    # `/` between folders, its bytes as UTF-8, as `Artifact#read` gives
    # an artifact's. Raises Errno::ENOENT when no file is at `path` by its
    # exact name, and for a path that is absolute or that `..` takes out
    # of the project, whatever is there, and for a file that is, or is in
    # a folder that is, a symbolic link to a path outside the project. A
    # link to a path inside the project is read. A file Git ignores can be read,
    # though it isn't among `project_files`.
    def read: (String path) -> String

    # A violation of `artifact`, an Artifact `check` was given, with
    # `message`, a String, and, where one artifact can fail the rule in
    # several ways, a `detail` that tells them apart, a String such as a
    # member's name. Rule files call it with anything, so it takes
    # anything, and raises Core::PluginError for what isn't those.
    def violation: (untyped artifact, untyped message, ?detail: untyped) -> Core::RuleResult

    private

    # What calls the plugin's helpers, by name, set before initialize.
    @crosslint_helpers: ^(String name, untyped input) -> untyped

    # The project's files, set before initialize.
    @crosslint_files: Array[String]

    # What reads a file of the project, set before initialize.
    @crosslint_read: ^(String path) -> String

    # Whether `path`, followed through . and .., stays in the project's
    # root, which an absolute path doesn't.
    def crosslint_inside?: (String path) -> bool
  end
end
