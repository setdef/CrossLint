module CrossLint
  # The class that declares a plugin's artifacts inherits from, for a
  # plugin whose artifacts depend on its settings and whose helper runs on
  # the Ruby CrossLint carries. The plugin declares the helper as
  # `helper NAME command=(crosslint)"ruby" file=FILE` and the artifacts as
  # `artifacts helper=NAME`, and `FILE`, relative to the plugin's folder,
  # defines one class named `Artifacts` that inherits from this one, with
  # a `declare` method. CrossLint runs the file and calls `declare` once,
  # while it reads the configuration and before it checks anything, and
  # adds the artifacts `declare` returns to those the plugin's manifest
  # declares. A policy with no applies-to applies to these as to any.
  #
  # The file runs on CrossLint's Ruby, as a Ruby rule's does. A mistake from
  # `mistake` stops CrossLint with exit status 2, naming the setting's
  # line; anything else the file or `declare` raises stops it too,
  # naming the plugin and the line of `artifacts` in its manifest.
  #
  # ```ruby
  # class Artifacts < CrossLint::Artifacts
  #   def declare(settings)
  #     folder = settings.find { |setting| setting.name == "folder" }&.arguments&.first || "lib"
  #     [artifact("ruby-file", primary: "#{folder}/{path}.rb", pieces: {"test" => "test/{path}_test.rb"})]
  #   end
  # end
  # ```
  class Artifacts
    # The artifacts the plugin declares, given the settings in its block
    # in the configuration, each a setting the manifest declares. Made
    # with `artifact`. Raises Core::PluginError unless a subclass defines
    # it.
    def declare: (Array[Core::Setting] settings) -> Array[Core::ArtifactDeclaration]

    # An artifact named `name`, found by the path pattern `primary`, with a
    # piece at each pattern of `pieces` by its name, and a key
    # from the pattern `key`, the name a debt entry can give each artifact
    # by in place of its primary piece's path. An `optional` artifact that
    # matches no file is reported only when no artifact of the plugin
    # matches one. With `dotfiles: false`, a primary piece whose match of
    # a placeholder has a file or a folder named with a leading `.` is no
    # artifact. A helper's Ruby calls it with anything, so it takes
    # anything, and raises
    # Core::PluginError when a name isn't a string, `pieces` isn't a
    # hash, a pattern isn't one, or `optional` or `dotfiles` isn't true or
    # false.
    def artifact: (untyped name, primary: untyped, ?pieces: untyped, ?key: untyped, ?optional: untyped, ?dotfiles: untyped) -> Core::ArtifactDeclaration

    # The mistake to raise for `setting`, one of those `declare` is
    # given: it names the configuration and the setting's line.
    def mistake: (String message, Core::Setting setting) -> Core::Mistake

    private

    @crosslint_line: Integer

    @crosslint_configuration: String
  end
end
