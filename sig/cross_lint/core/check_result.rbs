module CrossLint
  module Core
    # A warning CrossLint gives about a plugin, not about an artifact,
    # such as a primary pattern that matches no file: the manifest it is
    # about, the line, and the message.
    class Notice < Data
      # The manifest's path, relative to the project's root.
      attr_reader file: String

      # The line in the manifest.
      attr_reader line: Integer

      # What CrossLint warns of.
      attr_reader message: String

      # A notice with these fields.
      def self.new: (file: String, line: Integer, message: String) -> instance

      # A notice with these fields.
      def initialize: (file: String, line: Integer, message: String) -> void
    end

    # How many artifacts of each kind a check checked, how many plugins
    # stopped at a fault, and how many errors and warnings it reports.
    #
    # ```ruby
    # summary = CrossLint::Core::Summary.new(kinds: [["ruby-file", 9]], faults: 0, errors: 3, warnings: 0, warnings_shown: true)
    # summary.line # => "checked 9 ruby-file artifacts: 3 errors"
    # summary.with(kinds: [["ruby-file", 9], ["adr", 1]], errors: 0, warnings: 1).line
    # # => "checked 9 ruby-file and 1 adr artifacts: 1 warning"
    # summary.with(errors: 0).line # => "checked 9 ruby-file artifacts: no violations"
    # summary.with(faults: 1).line # => "checked 9 ruby-file artifacts: 1 fault, 3 errors"
    # summary.with(errors: 0, paid_off: 1, steps: ["2 accepted as debt"]).line
    # # => "checked 9 ruby-file artifacts: 1 entry paid off, 2 accepted as debt"
    # ```
    class Summary < Data
      # Each kind of artifact a policy applies to, by its name, or by
      # PLUGIN/NAME when two plugins have one of that name, with how many
      # artifacts of it there are, in the order the plugins declare them.
      attr_reader kinds: Array[[String, Integer]]

      # How many plugins stopped at a fault.
      attr_reader faults: Integer

      # How many violations of severity error the check reports.
      attr_reader errors: Integer

      # How many violations of severity warning the check reports.
      attr_reader warnings: Integer

      # False when --warnings=none hides warnings.
      attr_reader warnings_shown: bool

      # How many paid-off entries the steps report.
      attr_reader paid_off: Integer

      # What each step says of itself, such as "2 accepted as debt".
      attr_reader steps: Array[String]

      # A summary with these fields, and no paid-off entries or steps unless
      # given.
      def self.new: (kinds: Array[[String, Integer]], faults: Integer, errors: Integer, warnings: Integer, warnings_shown: bool,
                     ?paid_off: Integer, ?steps: Array[String]) -> instance

      # A summary with these fields, and no paid-off entries or steps unless
      # given.
      def initialize: (kinds: Array[[String, Integer]], faults: Integer, errors: Integer, warnings: Integer, warnings_shown: bool,
                       ?paid_off: Integer, ?steps: Array[String]) -> void

      # How many artifacts the check checked, of every kind.
      def artifacts: () -> Integer

      # The summary as one line, without the "crosslint: " that begins it.
      def line: () -> String

      # How many artifacts of each kind `kinds` counts, as "3 component and
      # 2 service artifacts", leaving out a kind with none when another has
      # some.
      def self.count: (Array[[String, Integer]] kinds) -> String

      private

      # The faults, errors, warnings, and paid-off entries, as words, and what
      # the steps say: "1 fault, 3 errors, 1 warning, 2 accepted as debt",
      # or "no violations", or "no errors" when warnings are hidden.
      def found: () -> String
    end

    # What a check found, filtered by --warnings and the verbosity: what
    # to report, and whether the check failed.
    class CheckResult < Data
      # The warnings about plugins to report.
      attr_reader notices: Array[Notice]

      # The violations to report, the paid-off entries, and under --all each
      # artifact checked that has no violation a step didn't excuse,
      # sorted by the path of the artifact's primary piece, then its line
      # (an artifact found in a whole file first), its name, the plugin,
      # the policy, and the message, with an error before a warning when
      # all of these match. An artifact with no violation has no policy or
      # message, and goes by its role instead. A paid-off entry has no
      # path, so its artifact takes the path's place.
      attr_reader findings: Array[Violation | PaidOffEntry | Artifact]

      # The summary, whatever the verbosity.
      attr_reader summary: Summary

      # `:normal`, `:quiet` for a report with no summary, or `:silent`
      # for none.
      attr_reader verbosity: (:normal | :quiet | :silent)

      # Whether the check failed: an error, a warning under
      # --warnings=error, or a paid-off entry, in a check that wrote nothing.
      attr_reader failed: bool

      # The fault each plugin that stopped stopped at, whatever the
      # verbosity. A plugin with a fault reports nothing else, and a check
      # with a fault ends with exit status 2, since some of its rules
      # didn't run.
      attr_reader faults: Array[Fault]

      # A line for each file a step wrote, unless the verbosity is
      # `:silent`.
      attr_reader wrote: Array[String]

      # A result with these fields, and nothing written unless `wrote`
      # says.
      def self.new: (notices: Array[Notice], findings: Array[Violation | PaidOffEntry | Artifact], summary: Summary,
                     verbosity: (:normal | :quiet | :silent), failed: bool, faults: Array[Fault], ?wrote: Array[String]) -> instance

      # A result with these fields, and nothing written unless `wrote`
      # says.
      def initialize: (notices: Array[Notice], findings: Array[Violation | PaidOffEntry | Artifact], summary: Summary,
                       verbosity: (:normal | :quiet | :silent), failed: bool, faults: Array[Fault], ?wrote: Array[String]) -> void

      # The findings that are violations.
      def violations: () -> Array[Violation]

      # The findings that are paid-off entries.
      def paid_off: () -> Array[PaidOffEntry]
    end
  end
end
