module CrossLint
  module Core
    # JavaScript that couldn't answer: Node isn't there, doesn't answer in
    # time, exits with a failure, or says the expression isn't valid. What
    # went wrong is the message; the use case that asked says which
    # setting it was for.
    class JavaScriptError < StandardError
    end

    # JavaScript answered that the regular expression itself isn't valid,
    # such as one with a quantifier on an anchor. The message is what
    # JavaScript said.
    class InvalidExpression < JavaScriptError
    end
  end
end
