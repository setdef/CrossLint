module CrossLint
  module Core
    # One of an artifact's pieces: its name, its path, and whether it
    # exists: a file or folder at the path, or, for a piece with a regex,
    # a match in the file there.
    class Piece < Data
      # The name of every artifact's primary piece, which no piece an
      # artifact declares can have.
      PRIMARY: String

      # The piece's name, as its artifact declares it, such as "test".
      attr_reader name: String

      # The piece's path, relative to the project's root, with `/`.
      attr_reader path: String

      # Whether a file or folder exists at `path`, by its exact name, or,
      # for a piece with a regex, whether the file there has a match.
      attr_reader exists: bool

      # For a piece with a regex, the line of the first match in its file,
      # from 1, or nil when there is none; nil for any other piece.
      attr_reader line: Integer?

      # For a piece with a regex, whether its file could be read: false
      # for no file, a folder, or a link out of the project. Nil for any
      # other piece.
      attr_reader readable: bool?

      # A piece with these fields, with no line and no readable unless
      # given.
      def self.new: (name: String, path: String, exists: bool, ?line: Integer?, ?readable: bool?) -> instance

      # A piece with these fields, as for `new`.
      def initialize: (name: String, path: String, exists: bool, ?line: Integer?, ?readable: bool?) -> void

      # Whether the piece exists.
      def exist?: () -> bool

      # The piece as the debug output says it: its name, its path, with
      # the line of its regex's first match, and whether it exists, or why
      # it doesn't for a piece with a regex:
      # `piece "test" at test/a_test.rb is missing`, or
      # `piece "action" is missing, since app/a.rb has no match of its regex`.
      def explanation: () -> String
    end

    # An artifact: a logical unit of a project, such as a component or a
    # route, which is not a file. CrossLint finds it by its primary piece,
    # which an artifact declaration's primary pattern matches, and it
    # has its other pieces.
    #
    # ```ruby
    # piece = CrossLint::Core::Piece.new(name: "test", path: "test/a_test.rb", exists: false)
    # artifact = CrossLint::Core::Artifact.new(plugin: "tests", role: "ruby-file", path: "lib/a.rb",
    #   match: {"path" => "a"}, pieces: [piece])
    # artifact.piece("test").exist? # => false
    # ```
    class Artifact < Data
      # The name of the plugin that declares the artifact.
      attr_reader plugin: String

      # The artifact's role: the name its declaration has, such as
      # "ruby-file".
      attr_reader role: String

      # The primary piece's path, relative to the project's root, with `/`.
      attr_reader path: String

      # What each placeholder of the primary pattern matched in `path`, and
      # each capture of its regex that took part in the match, by name.
      attr_reader match: Hash[String, String]

      # The pieces, in the order the declaration has them.
      attr_reader pieces: Array[Piece]

      # The name a debt entry can give the artifact by in place of its
      # primary piece's path, from its declaration's key pattern, or nil.
      attr_reader key: String?

      # The name CrossLint calls the artifact by in every violation and
      # debt entry: what its declaration's name pattern gives, or its
      # primary piece's path.
      attr_reader name: String

      # The line of the primary piece's file where its declaration's regex
      # matched, from 1, or nil for an artifact whose primary piece is a
      # whole file.
      attr_reader line: Integer?

      # An artifact with these fields, no key or line unless given, and
      # named by its primary piece's path unless given a name.
      def self.new: (plugin: String, role: String, path: String, match: Hash[String, String],
                     pieces: Array[Piece], ?key: String?, ?name: String, ?line: Integer?) -> instance

      # An artifact with these fields, as for `new`.
      def initialize: (plugin: String, role: String, path: String, match: Hash[String, String],
                       pieces: Array[Piece], ?key: String?, ?name: String, ?line: Integer?) -> void

      # Where the artifact is: its path, and its line, if it has one.
      #
      # ```ruby
      # CrossLint::Core::Artifact.new(plugin: "routes", role: "route", path: "config/routes.rb", match: {}, pieces: [], line: 2).location
      # # => "config/routes.rb:2"
      # ```
      def location: () -> String

      # The artifact as the debug output names it: its location, after its
      # name and "at" when the name isn't its path, as in
      # `get /cart at config/routes.rb:1`.
      def reference: () -> String

      # The artifact as the debug output says it: its plugin and role, its
      # location, its name and key when it has them, and each piece's
      # explanation: `tests/ruby-file lib/a.rb: piece "test" at
      # test/a_test.rb exists`.
      def explanation: () -> String

      # The piece called `name`. Raises KeyError when the declaration
      # has none of that name, which LoadProject rules out for every
      # policy.
      def piece: (String name) -> Piece
    end

    # What a rule reports when an artifact fails it: the plugin and policy
    # that ran the rule, the artifact by its name, the path of its primary
    # piece, and its role, a message, a severity, and a detail where one
    # artifact can fail a rule in several ways.
    class Violation < Data
      # The name of the plugin whose policy ran the rule.
      attr_reader plugin: String

      # The policy's name.
      attr_reader policy: String

      # The artifact's name, its primary piece's path unless its
      # declaration has a name pattern.
      attr_reader artifact: String

      # The artifact's role, its declaration's name.
      attr_reader role: String

      # What is wrong, such as "no test file at test/a_test.rb".
      attr_reader message: String

      # The severity, after the policy's and the configuration's.
      attr_reader severity: severity

      # What tells this violation from others of the same policy on the
      # same artifact, such as a missing member's name, or nil.
      attr_reader detail: String?

      # The artifact's key, or nil.
      attr_reader key: String?

      # The path of the artifact's primary piece, relative to the project's
      # root.
      attr_reader path: String

      # The artifact's line, or nil.
      attr_reader line: Integer?

      # Whether a built-in rule reported it, not a helper's rule.
      attr_reader built_in: bool

      # A violation with these fields, no key or line unless given,
      # `artifact` as its path unless given one, and reported by a
      # helper's rule unless `built_in` says otherwise.
      def self.new: (plugin: String, policy: String, artifact: String, role: String, message: String, severity: severity,
                     detail: String?, ?key: String?, ?path: String, ?line: Integer?, ?built_in: bool) -> instance

      # A violation with these fields, as for `new`.
      def initialize: (plugin: String, policy: String, artifact: String, role: String, message: String, severity: severity,
                       detail: String?, ?key: String?, ?path: String, ?line: Integer?, ?built_in: bool) -> void

      # The violation as the debug output says it: its severity, its
      # message, and its detail when it has one:
      # `error: no test file at test/a_test.rb, with detail "test"`.
      def explanation: () -> String
    end
  
    # What a Ruby rule reports, made with CrossLint::Rule#violation: the
    # artifact it checked, by the path of its primary piece and its role, a
    # message, and a detail where the rule gives one. The check adds the
    # plugin, policy, and severity to make a Violation.
    class RuleResult < Data
      # The path of the artifact's primary piece, relative to the project's
      # root.
      attr_reader path: String

      # The artifact's role.
      attr_reader role: String

      # What is wrong.
      attr_reader message: String

      # What tells this result from others of the rule on the artifact,
      # or nil.
      attr_reader detail: String?

      # A result with these fields.
      def self.new: (path: String, role: String, message: String, detail: String?) -> instance

      # A result with these fields.
      def initialize: (path: String, role: String, message: String, detail: String?) -> void
    end
  end
end
