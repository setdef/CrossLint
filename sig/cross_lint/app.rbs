module CrossLint
  # The composition root: builds the adapters, and hands them to a use
  # case.
  class App
    # The folder of CrossLint's built-in plugins, one folder each.
    PLUGINS: String

    # An app that reads the configuration through `configuration`, the
    # manifests through `manifests`, the project's files through
    # `project_files`, plugins' Ruby through `plugin_ruby`, and runs
    # helpers through `helpers`, with the built-in plugins in `plugins`,
    # and whose step track-debt reads and writes debt files through
    # `debt_files`. With no `helpers`, it runs them as processes, writing
    # what they write to standard error to `err` with `debug`. It fetches
    # shared plugins through `shared_plugins`, with Git by default, saying
    # what it fetches on `err`.
    def initialize: (?configuration: _Configuration, ?manifests: _PluginManifests, ?project_files: _ProjectFiles,
                     ?plugin_ruby: _PluginRuby, ?helpers: _Helpers?, ?shared_plugins: _SharedPlugins?, ?plugins: String,
                     ?debt_files: _DebtFiles, ?err: CLI::_Output, ?debug: bool) -> void

    # The project whose root is `start` or the nearest folder above it
    # with a configuration, read and checked (Core::LoadProject).
    def load_project: (String start) -> Core::Project

    # The result of checking that project (Core::Check), under the
    # command line's `warnings` and `verbosity`, nil where it gives none,
    # with each passing artifact under `all`, and with `flags`, the
    # plugins' flags given, without their dashes. `started` hears the
    # counts of the artifacts before any rule runs.
    def check: (String start, ?warnings: (:all | :none | :error)?, ?verbosity: (:normal | :quiet | :silent)?,
                ?all: bool, ?flags: Array[String], ?started: (^(Array[[String, Integer]] kinds) -> void)?) -> Core::CheckResult

    # The result of moving each shared plugin in that project's
    # configuration to the newest tag of its repository
    # (Core::UpdatePlugins), or of listing what it would move, with
    # `dry_run`.
    def update: (String start, ?dry_run: bool) -> Core::UpdateResult

    # The report that writes to `out` and `err`: JSON with `json`, else
    # text, in color with `color`, and each fault's trace with `debug`.
    def report: (out: CLI::_Output, err: CLI::_Output, ?json: bool, ?color: bool, ?debug: bool) -> _Report

    private

    @configuration: _Configuration

    @manifests: _PluginManifests

    @project_files: _ProjectFiles

    @plugin_ruby: _PluginRuby

    @helpers: _Helpers

    @shared_plugins: _SharedPlugins

    @built_in: Hash[String, String]

    @steps: Hash[String, Core::_Step]

    # The folder of each built-in plugin in `folder`, by name.
    def built_in_plugins: (String folder) -> Hash[String, String]
  end
end
