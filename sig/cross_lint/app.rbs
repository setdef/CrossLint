module CrossLint
  # The composition root: builds the adapters, and hands them to a use
  # case.
  class App
    # The folder of CrossLint's built-in plugins, one folder each, beside
    # the shared plugins this repository keeps.
    PLUGINS: String

    # The name of each built-in plugin, a folder of PLUGINS:
    # `["angular", "debt"]`. A project lists any other folder there as a
    # shared plugin, by URL and `path=`.
    BUILT_IN: Array[String]

    # An app that reads the configuration through `configuration`, the
    # manifests through `manifests`, the project's files through
    # `project_files`, helpers on the Ruby CrossLint carries through
    # `carried_ruby`, and runs the other helpers through `helpers`, with the built-in plugins in `plugins`,
    # each a folder named in `built_in` that holds a manifest,
    # and whose step track-debt reads and writes debt files through
    # `debt_files`. With no `helpers`, it runs them as processes, writing
    # what they write to standard error to `err` with `debug`. It reads
    # ng-nudge's files through `ng_nudge` and tests regular expressions
    # with Node by default, through `javascript`. It fetches
    # shared plugins through `shared_plugins`, with Git by default, saying
    # what it fetches on `err`. `reserved` has the name of each command of
    # CrossLint's, which no plugin that adds commands can be named; with
    # none given, they are the commands of the shipped usage spec.
    # `reserved_flags` has each way CrossLint's global flags are written,
    # which no flag of a plugin's command can be written as; with none
    # given, they are those of the shipped usage spec.
    def initialize: (?configuration: _Configuration, ?manifests: _PluginManifests, ?project_files: _ProjectFiles,
                     ?carried_ruby: _CarriedRuby, ?helpers: _Helpers?, ?shared_plugins: _SharedPlugins?, ?plugins: String, ?built_in: Array[String],
                     ?debt_files: _DebtFiles, ?ng_nudge: _NgNudge, ?javascript: _JavaScript, ?reserved: Array[String]?, ?reserved_flags: Array[String]?, ?err: CLI::_Output, ?debug: bool) -> void

    # How each global flag of `spec`, with --help and --version, is
    # written on a command line, such as "--quiet" and "-q".
    def self.global_flag_names: (UsageSpec spec) -> Array[String]

    # The project whose root is `start` or the nearest folder above it
    # with a configuration, read and checked (Core::LoadProject).
    def load_project: (String start) -> Core::Project

    # The result of checking that project, as `check_project` does.
    def check: (String start, ?warnings: (:all | :none | :error)?, ?verbosity: (:normal | :quiet | :silent)?,
                ?all: bool, ?command: [String, String]?, ?flags: Hash[String, String | true],
                ?started: (^(Array[[String, Integer]] kinds) -> void)?) -> Core::CheckResult

    # The result of checking `project` (Core::Check), under the command
    # line's `warnings` and `verbosity`, nil where it gives none, with
    # each passing artifact under `all`, and as the command `command`
    # names, a plugin and one of its commands, when it is given, with the
    # flags of that command the person gave.
    # `started` hears the counts of the artifacts before any rule runs.
    def check_project: (Core::Project project, ?warnings: (:all | :none | :error)?, ?verbosity: (:normal | :quiet | :silent)?,
                        ?all: bool, ?command: [String, String]?, ?flags: Hash[String, String | true],
                        ?started: (^(Array[[String, Integer]] kinds) -> void)?) -> Core::CheckResult

    # The plugins the project at `start` lists that are on disk, without
    # fetching or running anything (Core::LoadProject#listed).
    def listing: (String start) -> Core::PluginListing

    # The name of each built-in plugin's commands, by the plugin's name,
    # whether or not a project lists it.
    def built_in_commands: () -> Hash[String, Array[String]]

    # The result of moving each shared plugin in that project's
    # configuration to the newest tag of its repository that is
    # compatible with its ref (Core::UpdatePlugins), or of listing what
    # it would move, with `dry_run`; with `latest`, to the highest
    # version even when it isn't compatible.
    def update: (String start, ?dry_run: bool, ?latest: bool) -> Core::UpdateResult

    # The result of writing the configuration with the recommended
    # plugins in the folder `start` (Core::InitConfiguration), or of
    # listing what it would write, with `dry_run`; with `force`, over a
    # configuration that is there.
    def init: (String start, ?force: bool, ?dry_run: bool) -> Core::InitResult

    # The result of moving the project at `start` from ng-nudge
    # (Core::NgNudge::Move): writing its configuration and moving its
    # debt file, or listing what it would change with `dry_run`; with
    # `force`, over a configuration and a debt file that are there.
    # `planned` hears each change before the first is made.
    def move_from_ng_nudge: (String start, ?force: bool, ?dry_run: bool, ?planned: (^(Array[String], Array[String]) -> void)?) -> Core::NgNudge::MoveResult

    # The report that writes to `out` and `err`: JSON with `json`, else
    # text, in color with `color`, and each fault's trace with `debug`.
    def report: (out: CLI::_Output, err: CLI::_Output, ?json: bool, ?color: bool, ?debug: bool) -> _Report

    private

    # The use case that reads a project's configuration and plugins.
    def loader: () -> Core::LoadProject

    @configuration: _Configuration

    @reserved: Array[String]

    @reserved_flags: Array[String]

    @manifests: _PluginManifests

    @project_files: _ProjectFiles

    @carried_ruby: _CarriedRuby

    @helpers: _Helpers

    @shared_plugins: _SharedPlugins

    @built_in: Hash[String, String]

    @debt_files: _DebtFiles

    @ng_nudge: _NgNudge

    @javascript: _JavaScript

    @steps: Hash[String, Core::_Step]

    # The folder of each built-in plugin in `folder` among `names`, by name.
    def built_in_plugins: (String folder, Array[String] names) -> Hash[String, String]
  end
end
