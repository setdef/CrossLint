module CrossLint
  # The crosslint command: reads its command line, does what the person
  # asked for, and returns the exit status.
  #
  # What the person asked for goes to `out`. Everything CrossLint says
  # about itself goes to `err`, each line beginning with "crosslint:".
  class CLI
    # Where CrossLint writes: standard output or standard error, or a
    # `StringIO` in the tests.
    interface _Output
      # Writes `text` as it is.
      def write: (String text) -> untyped

      # Writes `line`, and a line break.
      def puts: (String line) -> untyped

      # Whether it is a terminal.
      def tty?: () -> bool

      # Writes out what it holds.
      def flush: () -> untyped
    end

    # The environment: `ENV`, or a Hash in the tests.
    interface _Environment
      # The value of the variable `name`, or `default` when it isn't set.
      def fetch: (String name, String default) -> String
    end

    # What begins each line CrossLint writes about itself.
    PREFIX: String

    # What init says to do next, once it has moved a project from ng-nudge.
    NEXT_STEPS: String

    # Where to report a bug.
    ISSUES: String

    # Each value of --warnings, as Core::Check takes it.
    WARNINGS: Hash[String, :all | :none | :error]

    # `argv` is the command line's words, `out` and `err` standard output
    # and standard error, and `env` the environment. `spec` is the usage
    # spec, which is read from UsageSpec::PATH when it is nil; and `app` is
    # the composition root, an App when it is nil.
    def initialize: (Array[String] argv, out: _Output, err: _Output, env: _Environment,
                     ?spec: UsageSpec?, ?app: App?) -> void

    # Runs the command line, and returns the exit status.
    def run: () -> Integer

    private

    @argv: Array[String]

    @out: _Output

    @err: _Output

    @env: _Environment

    @spec: UsageSpec?

    @app: App?

    # Writes the program's name and version, and returns 0.
    def version: (UsageSpec spec) -> Integer

    # Runs crosslint help: writes the help of the command `topic`, or of
    # the program when it is nil, as --help does, and returns 0.
    def explain: (UsageSpec spec, CommandLine line, UsageSpec::Command? topic) -> Integer

    # The help of `command`, or of the program when it is nil, which lists
    # the commands of the plugins the project lists, and says why when it
    # can't, since help never fails for a mistake in a project.
    def render_help: (UsageSpec spec, CommandLine line, UsageSpec::Command? command) -> String

    # The plugins the project lists that are on disk, or the mistake that
    # stopped the reading of the project. It fetches nothing.
    def listing: (UsageSpec spec, CommandLine line) -> (Core::PluginListing | Core::Mistake)

    # What the program's help says of the plugins in `found`: their
    # commands, a line for each shared plugin not fetched yet, or the
    # reason none is shown.
    def help_plugins: (Core::PluginListing | Core::Mistake found) -> Help::Plugins

    # Prints the help of the plugin or command the words of `line` name,
    # and returns 0. Raises CommandLine::Error for words that name neither
    # (PluginCommands), though it prints the program's help, with the
    # reason, when the project can't be read or the plugin isn't fetched
    # yet.
    def plugin_help: (UsageSpec spec, CommandLine line) -> Integer

    # The reader of plugin commands and what the project lists, once the
    # first word of `line` is known to be a plugin the configuration lists.
    # Raises CommandLine::Error before anything is fetched or loaded when
    # it is not.
    def resolved: (UsageSpec spec, CommandLine line) -> [PluginCommands, Core::PluginListing | Core::Mistake]

    # `mistake` as a line says it: its file and line, then its message.
    def text: (Core::Mistake mistake) -> String

    # Runs crosslint check: checks the project, writes the report, and
    # returns 1 when the check failed, 0 when it passed, and 2 at a fault.
    def check: (UsageSpec spec, CommandLine line) -> Integer

    # Runs crosslint PLUGIN COMMAND, as the words of `line` say: finds the
    # plugin and its command among those the project lists, which is a
    # mistake, naming the nearest spelling, when there is none, and runs
    # the check as the command, which exits with 0 unless a fault stops a
    # plugin.
    def plugin_command: (UsageSpec spec, CommandLine line) -> Integer

    # The app to use: the one given, or one that has the commands of
    # `spec` as the names no plugin that adds commands can have.
    def application: (UsageSpec spec) -> App

    # Checks `project`, writes the report, and returns the exit status:
    # 2 at a fault, 1 when the check failed, 0 otherwise. `command` is a
    # plugin's name and the name of one of its commands, when the check
    # runs as a plugin's command.
    def check_project: (App app, CommandLine line, Core::Project project, ?[String, String]? command) -> Integer

    # Runs crosslint update: moves each shared plugin in the project's
    # configuration to the newest tag of its repository, or with --dry-run
    # lists what it would move, and writes a line for each shared plugin
    # to standard error, none with --silent. Returns 0.
    def update: (CommandLine line) -> Integer

    # Runs crosslint init: writes the configuration with the recommended
    # plugins in the project's folder, or with --dry-run lists what it
    # would write, and says on standard error what it wrote, nothing with
    # --silent. With --from-ng-nudge, moves the project from ng-nudge
    # instead. Returns 0.
    def init: (UsageSpec spec, CommandLine line) -> Integer

    # Moves the project at `root` from ng-nudge, with `force` and
    # `dry_run` as given: says each change before it makes the first, as
    # "will" or, with `dry_run`, "would", and says what to do next after
    # the last, unless `silent`. Returns 0.
    def move_from_ng_nudge: (App app, String root, force: bool, dry_run: bool, silent: bool) -> Integer

    # Whether to color the report: never with --no-color, a NO_COLOR that
    # isn't empty, or TERM=dumb; else with a FORCE_COLOR that isn't empty,
    # or when standard output is a terminal.
    def color?: (CommandLine line) -> bool

    # Writes `message` to standard error, and returns exit status 2.
    def say: (String message) -> Integer

    # Says that `error` is a bug in CrossLint and where to report it, with
    # where it stopped under --debug, and returns exit status 2.
    def bug: (Exception error) -> Integer

    # Whether --debug is on the command line or DEBUG is set to a value
    # that isn't empty.
    def debug?: () -> bool
  end
end
