module CrossLint
  # The contract tests for each port, which every adapter of it passes,
  # the in-memory one included. A Minitest test includes a contract and
  # defines the methods its interface lists.
  module Testing
    # What a test of a configuration adapter defines.
    interface _ConfigurationTest
      # A port for the projects in `projects`, each a folder relative to
      # the test's base, with a configuration that lists those plugins.
      # With `broken`, the project in that folder has a configuration with
      # a mistake on line 2.
      def configuration_port: (Hash[String, Array[String]] projects, ?broken: String?) -> _Configuration

      # A port whose project in `folder("example")` has a configuration
      # that lists, in this order, the plugins "https://github.com/OWNER/REPO"
      # at ref "v1.2.0", "angular" with the settings `src-dir "src"` and
      # `role "store" files="{path}.store.ts"` holding `expects "spec"`,
      # and ".config/crosslint/signatures"; then the policy lines
      # "angular/prefer-css-over-scss" at severity error,
      # "angular/spec-exists" at severity warning, and
      # "signatures/has-test" disabled; and sets warnings to "error" and
      # verbosity to "silent".
      def example_configuration_port: () -> _Configuration

      # The absolute path of `path`, relative to the test's base, which
      # exists as a folder for an adapter that needs it to.
      def folder: (String path) -> String

      # The root find_root finds for a folder in the base that no project
      # of the test's contains: nil, unless a folder above the base has a
      # configuration.
      def root_outside: () -> String?
    end

    # The tests every adapter of the configuration port passes.
    module ConfigurationContract : _ConfigurationTest, Minitest::Assertions
      # A project's root can be the folder find_root starts from.
      def test_finds_the_root_in_the_folder_it_starts_from: () -> void

      # find_root returns the nearest folder above with a configuration.
      def test_finds_the_nearest_root_above_the_folder_it_starts_from: () -> void

      # find_root returns nil when no folder above has a configuration.
      def test_finds_no_root_when_no_folder_above_has_a_configuration: () -> void

      # read returns the listed plugins in order, each with its line, and
      # no ref, settings, policy lines, warnings, or verbosity when the
      # configuration has none.
      def test_reads_the_plugins_in_the_order_they_are_listed: () -> void

      # read returns each plugin's ref, and whether it is a built-in,
      # local, or shared plugin.
      def test_reads_the_ref_and_kind_of_each_plugin: () -> void

      # read returns a plugin's settings, and the settings inside them.
      def test_reads_the_settings_block_of_a_plugin: () -> void

      # read returns each policy line's name, whether it enables or
      # disables the policy, and its severity.
      def test_reads_what_a_policy_line_changes: () -> void

      # read returns the warnings and verbosity modes.
      def test_reads_warnings_and_verbosity: () -> void

      # read raises a mistake naming the file and the line.
      def test_names_the_file_and_line_of_a_mistake: () -> void

      # read raises a mistake naming the file when there is none.
      def test_names_the_file_when_the_project_has_no_configuration: () -> void

      private

      # The configuration `example_configuration_port` holds.
      def example_configuration: () -> Core::Configuration
    end

    # What a test of a plugin-manifest adapter defines.
    interface _PluginManifestsTest
      # A port with a manifest in each folder of `example`, relative to
      # `base`, that declares the artifact "ruby-file" (files
      # "lib/{path}.rb", companions "signature" at "sig/{path}.rbs" and
      # "test" at "test/{path}_test.rb"); the rule "names-class" in
      # "rules/names_class.rb"; the helper "members" running
      # "helpers/members.mjs" on "node"; and, each applying to
      # "ruby-file", the policies
      #
      # * "has-signature", with no condition, running "companion-exists"
      #   with companion "signature" at severity "warning";
      # * "names-match", when not companion-exists "test", running
      #   "names-class" with no severity;
      # * "covered", when all of companion-exists "signature" and
      #   companion-exists "test", running "companion-exists" with
      #   companion "test" at severity "error";
      # * "either", when any of companion-exists "signature" and not
      #   companion-exists "test", running "companion-absent" with
      #   companion "signature" and no severity;
      #
      # then the policy "has-debt", which a step reports, the settings
      # "file" and "report-entries", the flag "update-debt", and the step
      # "track-debt".
      #
      # A manifest with a mistake on line 2 is in each folder of `broken`.
      def manifests_port: (?example: Array[String], ?broken: Array[String]) -> _PluginManifests

      # The absolute path the folders are relative to.
      def base: () -> String
    end

    # The tests every adapter of the plugin-manifest port passes.
    module PluginManifestsContract : _PluginManifestsTest, Minitest::Assertions
      # read returns the artifacts, with their companions, the rules, and
      # the helpers the manifest declares.
      def test_reads_the_artifacts_rules_and_helpers_a_manifest_declares: () -> void

      # read returns each policy's name, artifact, and rules with their
      # arguments.
      def test_reads_what_each_policy_applies_to_and_runs: () -> void

      # read returns each policy's `when` condition, with `not`, `all`,
      # and `any` nested, and nil for a policy with none.
      def test_reads_the_when_condition_of_a_policy: () -> void

      # read returns a rule line's severity, and nil when it has none.
      def test_reads_the_severity_of_a_rule_line_when_it_has_one: () -> void

      # read returns the policies a step reports apart from the others,
      # and the settings, flags, and steps, each in order.
      def test_reads_the_settings_flags_and_steps_a_manifest_declares: () -> void

      # read finds a manifest in the root folder itself.
      def test_reads_the_manifest_of_the_root_folder_itself: () -> void

      # read returns nil for a folder with no manifest.
      def test_reads_nothing_from_a_folder_with_no_manifest: () -> void

      # read raises a mistake naming the file and the line.
      def test_names_the_file_and_line_of_a_mistake: () -> void

      private

      # The manifest `port` reads in `folder`, which has one.
      def read_manifest: (_PluginManifests port, String folder) -> Core::Manifest

      # The manifest of the "plugins/signatures" folder of the example.
      def signatures_manifest: () -> Core::Manifest

      # A condition that the companion exists.
      def exists: (String companion) -> Core::Condition::CompanionExists

      # The condition's inspection without its lines.
      def without_lines: (untyped condition) -> String
    end

    # What a test of a project-files adapter defines.
    interface _ProjectFilesTest
      # A port for the project at project_root, whose files are `listed`,
      # which Git lists, some tracked and some not, and `ignored`, which
      # exist but Git ignores. Each is a path relative to the root, with `/`,
      # and each file holds its path and a newline.
      def project_files_port: (listed: Array[String], ?ignored: Array[String]) -> _ProjectFiles

      # The absolute path of the project's root.
      def project_root: () -> String

      # The absolute path of a folder that isn't in a Git working tree.
      def outside_root: () -> String
    end

    # The tests every adapter of the project-files port passes.
    module ProjectFilesContract : _ProjectFilesTest, Minitest::Assertions
      # files lists what Git lists, and nothing it ignores.
      def test_lists_every_file_git_sees_and_none_it_ignores: () -> void

      # exist? finds files and folders, ignored ones included, by their
      # exact names.
      def test_says_whether_a_path_exists_by_its_exact_name: () -> void

      # read returns a file's text, ignored files included, and raises
      # Errno::ENOENT for a name that differs in case or isn't there.
      def test_reads_a_file_by_its_exact_name: () -> void

      # files raises a mistake for a root outside a Git working tree.
      def test_stops_at_a_root_outside_a_git_working_tree: () -> void
    end

    # What a test of a plugin-Ruby adapter defines.
    interface _PluginRubyTest
      # A port that holds `files`, each Ruby source by its path relative
      # to plugin_base, with `/`.
      def plugin_ruby_port: (Hash[String, String] files) -> _PluginRuby

      # The absolute path of the folder that holds each plugin's folder.
      def plugin_base: () -> String
    end

    # The tests every adapter of the plugin-Ruby port passes.
    module PluginRubyContract : _PluginRubyTest, Minitest::Assertions
      # load defines a file's classes in the namespace, not at the top level.
      def test_puts_a_files_constants_in_the_namespace_it_is_given: () -> void

      # load keeps classes of one name in two plugins apart.
      def test_keeps_two_plugins_classes_of_one_name_apart: () -> void

      # load raises a mistake naming the manifest and the line for a file
      # that isn't there.
      def test_stops_at_a_file_the_plugins_folder_lacks: () -> void

      # load raises what the file raises.
      def test_raises_what_the_file_raises: () -> void

      private

      # A local plugin named `name`, in that folder of plugin_base.
      def ruby_plugin: (String name) -> Core::Plugin
    end

    # What a test of a helpers adapter defines.
    interface _HelpersTest
      # A port that finds a command named "ruby" on the PATH and no other,
      # unless the test sets up more.
      def helpers_port: () -> _Helpers

      # The absolute path of the project's root.
      def helper_root: () -> String

      # The plugin "tests", whose manifest is "tests/plugin.kdl", with the
      # helper "echo" on line 4, which answers each request `input` with
      # `{"echo" => input}`, and the helper "fails" on line 5, which writes
      # "nope" to standard error and exits with status 3 before it
      # answers; both run on `command`, or on the test's own command.
      def helper_plugin: (?command: String?) -> Core::Plugin
    end

    # The tests every adapter of the helpers port passes.
    module HelpersContract : _HelpersTest, Minitest::Assertions
      # call returns each answer, in order, text that isn't ASCII
      # included.
      def test_answers_each_request_with_what_the_helper_answers: () -> void

      # call raises a plugin error saying the helper exited, and what it
      # wrote.
      def test_says_what_a_failing_helper_did_and_wrote: () -> void

      # start raises a mistake naming the plugin and the command when the
      # command isn't on the PATH.
      def test_stops_before_any_helper_starts_at_a_command_not_on_the_path: () -> void
    end

    # What a report adapter's test defines.
    interface _ReportTest
      # A port that writes where `reported` reads.
      def report_port: () -> _Report

      # What the port wrote: each violation as its path, message, plugin,
      # policy, and severity; each notice as its file, line, and message;
      # each fault as its plugin, rule, artifact, and message; each stale
      # entry, one whose message is "is stale", as its artifact, message,
      # plugin, and policy; each line a step wrote; and the summary line
      # without "crosslint: ", or nil for none.
      def reported: () -> {findings: Array[[String, String, String, String, Core::severity]],
                           notices: Array[[String, Integer, String]], faults: Array[[String, String, String?, String]],
                           stale: Array[[String, String, String, String]], wrote: Array[String], summary: String?}
    end

    # The tests every adapter of the report port passes.
    module ReportContract : _ReportTest, Minitest::Assertions
      # write reports the violations in the order the result has them.
      def test_reports_each_violation_in_order: () -> void

      # write reports notices, and none of them as a finding.
      def test_reports_each_notice_apart_from_the_findings: () -> void

      # start reports no finding, notice, or summary.
      def test_reports_no_finding_and_no_summary_when_a_check_starts: () -> void

      # write reports the summary at the normal verbosity.
      def test_reports_the_summary_unless_quiet_or_silent: () -> void

      # write reports the findings and no summary under --quiet.
      def test_reports_no_summary_when_quiet: () -> void

      # write writes nothing under --silent for a result with no faults.
      def test_reports_nothing_when_silent: () -> void

      # write reports each stale entry, and none of them as a violation.
      def test_reports_each_stale_entry_apart_from_the_violations: () -> void

      # write reports each line a step wrote, except under --silent.
      def test_reports_each_file_a_step_wrote_unless_silent: () -> void

      # write reports each fault, even under --silent.
      def test_reports_each_fault_even_when_silent: () -> void

      private

      # A violation of tests/has-test on the ruby-file at `path`.
      def violation: (String path, String message, ?Core::severity severity) -> Core::Violation

      # A result with these findings, notices, verbosity, faults, and lines
      # written, and a summary of two ruby-file artifacts with no
      # violations.
      def result: (Array[Core::Violation | Core::Stale | Core::Artifact] findings, ?notices: Array[Core::Notice],
                   ?verbosity: (:normal | :quiet | :silent), ?faults: Array[Core::Fault], ?wrote: Array[String]) -> Core::CheckResult
    end
    # What a test of a debt-files adapter defines.
    interface _DebtFilesTest
      # A port with no debt files under debt_root. With `broken`, the file
      # at that path, relative to debt_root, has an entry with no rule on
      # line 3.
      def debt_files_port: (?broken: String?) -> _DebtFiles

      # The absolute path of the project's root.
      def debt_root: () -> String
    end

    # The tests every adapter of the debt-files port passes.
    module DebtFilesContract : _DebtFilesTest, Minitest::Assertions
      # read gives a file that doesn't exist no entries and no header.
      def test_reads_no_entries_and_no_header_from_a_file_that_doesnt_exist: () -> void

      # read gives back each entry write wrote, in order, every field kept,
      # tabs, quotes, line endings, and non-ASCII text included, each with
      # a source and the line it starts on, the first on line 2, and a
      # header.
      def test_reads_back_each_entry_it_wrote_in_order_with_its_line: () -> void

      # Writing what read gave changes nothing read gives next.
      def test_writes_back_what_it_read_unchanged: () -> void

      # A file written with no entries reads back with its header.
      def test_keeps_the_header_of_a_file_with_no_entries: () -> void

      # write makes the folder a file goes in.
      def test_makes_the_folder_of_a_file_it_writes: () -> void

      # read raises a mistake naming the file and the line.
      def test_names_the_file_and_line_of_a_mistake: () -> void
    end
  end
end
