module CrossLint
  module Adapters
    # The report port as lines of text: each finding on a line of
    # standard output, and each notice, each fault, and the summary on
    # standard error, beginning with "crosslint: ". The words CrossLint
    # writes are ASCII. A path or other text from the project is written
    # as it is, in UTF-8, and the bytes of text that isn't valid UTF-8 are
    # written unchanged.
    #
    # A violation's line is its path, with the line a primary's regex
    # found its artifact on, its artifact's name when that differs from
    # the path, its message, and its plugin and policy, with
    # "warning: " before the message of a warning:
    #
    #     lib/a.rb: no test file at test/a_test.rb (tests/has-test)
    #     lib/a.rb: warning: no signature file at sig/a.rbs (tests/has-signature)
    #     lib/app/b.rb: app/b: no test file at test/app/b_test.rb (tests/has-test)
    #     config/routes.rb:2: get /cart: no action in app/controllers/carts_controller.rb (routes/has-action)
    #
    # A stale entry's line is its artifact, its message, and its plugin
    # and policy, as a violation's is. A line for each file a step wrote,
    # such as "wrote .config/crosslint/debt.tsv: 2 entries added, 0
    # removed", goes after the faults and before the summary.
    #
    # A passing artifact's line, under --all, is its path, its name when
    # that differs, and its role: `lib/b.rb: ruby-file passes`. With color, a violation's message is
    # red for an error and yellow for a warning, and nothing else is
    # colored.
    #
    # A fault's line is its plugin, its rule, the artifact if any, and the
    # message, whatever the verbosity; with `debug`, its trace follows,
    # one `  from` line each, and without, unless under --silent, one
    # line says to run with --debug to see the traces:
    #
    #     fault in plugin tests: rule names-class on lib/a.rb raised RuntimeError: boom
    class TextReport
      include _Report

      # What begins each line CrossLint writes about itself.
      PREFIX: String

      # The ANSI escape that starts each severity's color.
      COLORS: Hash[Core::severity, String]

      # The ANSI escape that ends a color.
      RESET: String

      # A report that writes findings to `out` and the rest to `err`, in
      # color when `color` is true, and with each fault's trace when
      # `debug` is true.
      def initialize: (out: CLI::_Output, err: CLI::_Output, ?color: bool, ?debug: bool) -> void

      private

      @out: CLI::_Output

      @err: CLI::_Output

      @color: bool

      @debug: bool

      # Writes the result's faults to standard error.
      def write_faults: (Core::CheckResult result) -> void

      # Writes the result's findings to standard output.
      def write_findings: (Core::CheckResult result) -> void

      # Where a finding is, as its line starts: the artifact's primary
      # path, with the line a regex found it on, if any, then its name
      # when that differs from the path.
      def where: (String path, Integer? line, String name) -> String

      # Writes `line` to standard error, after PREFIX.
      def say: (String line) -> void
    end
  end
end
