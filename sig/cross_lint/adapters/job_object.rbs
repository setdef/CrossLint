module CrossLint
  module Adapters
    # A helper's process tree on Windows: a job object, which every
    # process the helper starts joins, MSYS2's included, which
    # `taskkill /T` misses. Closing its last handle, as when CrossLint
    # ends, ends its processes.
    class JobObject
      # Starts the program and arguments `command` in `root`, with `environment`'s
      # changes to its environment, with pipes to its
      # standard input, written in binary mode, and its output and error.
      def self.popen3: (Array[String] command, String root, Hash[String, String?] environment) -> [IO, IO, IO, Process::Waiter]

      # Closes `input`, the pipe to a helper's standard input, which
      # raises EPIPE on Windows when the helper has exited; that ends
      # nothing.
      def self.close_input: (IO input) -> void

      # The size of JOBOBJECT_EXTENDED_LIMIT_INFORMATION on x64.
      LIMITS_SIZE: Integer

      # Where its LimitFlags are.
      LIMIT_FLAGS: Integer

      # JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE.
      KILL_ON_JOB_CLOSE: Integer

      # JobObjectExtendedLimitInformation.
      EXTENDED_LIMIT_INFORMATION: Integer

      # PROCESS_SET_QUOTA and PROCESS_TERMINATE.
      ASSIGN: Integer

      # What OpenProcess answers for a pid no process has.
      INVALID_PARAMETER: Integer

      # A job object that holds the process `pid`. Raises
      # Core::PluginError, saying which Windows call failed with which
      # error, and closes the job, when Windows doesn't create the job,
      # set its limits, or put the process in it. A process that has
      # exited and been reaped has nothing to hold, and raises nothing.
      def initialize: (Integer pid) -> void

      # Ends every process in the job and closes the job, the first time;
      # does nothing after.
      def kill: () -> void

      private

      @kernel32: Fiddle::Handle

      @job: untyped

      # Puts the process `pid` in the job, or does nothing when no process
      # has that pid, as one that has exited. Raises Core::PluginError when
      # Windows doesn't open the process for another reason, or put it in.
      def hold: (Integer pid) -> void

      # What kernel32's function `name`, of `arguments` and `result`
      # Fiddle types, returns for `values`. Raises Core::PluginError, as
      # every call that fails by returning zero does.
      def checked: (String name, Array[Integer] arguments, Integer result, *untyped values) -> untyped

      # The error for the call `name` that returned zero.
      def failed: (String name) -> Core::PluginError

      # Calls kernel32's function `name`, of `arguments` and `result`
      # Fiddle types, with `values`.
      def call: (String name, Array[Integer] arguments, Integer result, *untyped values) -> untyped
    end
  end
end
