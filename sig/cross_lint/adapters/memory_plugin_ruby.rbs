module CrossLint
  module Adapters
    # The plugin-Ruby port in memory, for the use cases' tests: each
    # file is a proc, by its path, that defines the file's
    # constants in the namespace it is given.
    #
    # ```ruby
    # manifest = CrossLint::Core::Manifest.new(file: "p/plugin.kdl", artifacts: [], policies: [], rules: [], helpers: [])
    # listing = CrossLint::Core::ListedPlugin.new(name: "./p", ref: nil, settings: [], line: 1)
    # plugin = CrossLint::Core::Plugin.new(name: "p", folder: "/p", listing:, manifest:)
    # namespace = Module.new
    # port = CrossLint::Adapters::MemoryPluginRuby.new({"/p/two.rb" => ->(within) { within.const_set(:Two, 2) }})
    # port.load(plugin, "two.rb", 1, namespace)
    # namespace::Two # => 2
    # ```
    class MemoryPluginRuby
      include _PluginRuby

      # A port that holds `files`, each a proc by its path, which the port
      # expands (on Windows, with a drive letter).
      def initialize: (?Hash[String, ^(Module namespace) -> void] files) -> void

      private

      @files: Hash[String, ^(Module namespace) -> void]
    end
  end
end
