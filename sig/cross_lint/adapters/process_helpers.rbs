module CrossLint
  module Adapters
    # The helpers port as processes. Each helper runs as `COMMAND FILE`,
    # its command found on the PATH and its file in its plugin's folder,
    # in the project's root, from its first call to the check's end. A
    # request is one line of JSON on its standard input, and its answer
    # one line of JSON on its standard output. What it writes to standard
    # error goes to CrossLint's standard error under --debug, each line
    # after "crosslint: helper NAME: ", and into the error when it fails.
    #
    # A helper runs with the environment CrossLint was started with
    # (HelperEnvironment), and finds its command on that PATH.
    #
    # A helper runs in a process tree of its own: a process group on
    # macOS and Linux, a job object on Windows. A helper that doesn't
    # answer within the time limit is ended with every process in its
    # tree. When the check ends, each helper's input is closed, each has
    # a few seconds to exit, all at once, and whatever is still running,
    # and whatever a helper left running, is ended. Ctrl-C ends every
    # tree at once.
    class ProcessHelpers
      include _Helpers

      # How long CrossLint waits for each answer, in seconds.
      TIME_LIMIT: Integer

      # How long CrossLint waits for a helper to exit once its input is
      # closed, in seconds.
      STOP_LIMIT: Integer

      # Whether CrossLint runs on Windows.
      WINDOWS: bool

      # The process tree this system starts a helper in: JobObject on
      # Windows, ProcessGroup elsewhere.
      TREE: _Tree

      # How long the port waits for each answer, in seconds.
      attr_reader time_limit: Numeric

      # How long the port waits for a helper to exit once its input is
      # closed, in seconds.
      attr_reader stop_limit: Numeric

      # A port that writes what a helper writes to standard error to `err`
      # when `debug` is true, waits `time_limit` seconds for each answer
      # and `stop_limit` seconds for each helper to exit once its input
      # is closed, and finds commands on the PATH in `env`, the
      # environment. A helper starts in `tree`, a class of the shape of
      # TREE's two; a helper that can't be put in a tree is ended, and fails.
      def initialize: (err: CLI::_Output, debug: bool, ?time_limit: Numeric, ?stop_limit: Numeric, ?env: _Environment,
                       ?tree: _Tree) -> void

      # What starts a helper and holds the processes it starts: a class,
      # as ProcessGroup and JobObject are.
      interface _Tree
        # Starts the program and file `command` in `root`, with
        # `environment`'s changes to its environment, with pipes to its
        # standard input, output, and error.
        def popen3: ([String, String] command, String root, Hash[String, String?] environment) -> [IO, IO, IO, Process::Waiter]

        # Closes the pipe `input` to a helper's standard input.
        def close_input: (IO input) -> void

        # The tree of the process `pid`, which popen3 started. Raises
        # Core::PluginError when it can't hold it.
        def new: (Integer pid) -> _TreeProcesses
      end

      # The processes of one helper's tree.
      interface _TreeProcesses
        # Ends every process in the tree.
        def kill: () -> void
      end

      # What the port reads of the environment, as ENV or a hash has it.
      interface _Environment
        # The value of `name`, or `default` when it is unset.
        def fetch: [T] (String name, T default) -> (String | T)

        # Each variable and its value that `block` is true of.
        def select: () { (String name, String value) -> boolish } -> Hash[String, String]
      end

      # The program called `command`: in the first folder of the PATH, each
      # separated by File::PATH_SEPARATOR, that has one, the file named
      # `command` with one of PATHEXT's extensions, separated by ";", or
      # else with none, that is a file Ruby can run. Windows sets PATHEXT,
      # as ".COM;.EXE;.BAT;.CMD" and more; elsewhere it is unset. nil when
      # there is none.
      def find: (String command) -> String?

      private

      @err: CLI::_Output

      @debug: bool

      @environment: HelperEnvironment

      @tree_class: _Tree

      # The program and file `plugin`'s `helper` runs. Raises Core::Mistake
      # when the program isn't on the PATH or the file isn't in the
      # plugin's folder.
      def command: (Core::Plugin plugin, Core::HelperDeclaration helper) -> [String, String]

      # The helpers of one check.
      class Running
        include _RunningHelpers

        # Helpers that run `commands`, each a program and a file by the
        # plugin's and the helper's names, in `root`.
        def initialize: (String root, Hash[[String, String], [String, String]] commands, err: CLI::_Output, debug: bool,
                         time_limit: Numeric, stop_limit: Numeric, tree: _Tree, environment: Hash[String, String?]) -> void

        private

        @environment: Hash[String, String?]

        @tree_class: _Tree

        @root: String

        @commands: Hash[[String, String], [String, String]]

        @err: CLI::_Output

        @debug: bool

        @time_limit: Numeric

        @stop_limit: Numeric

        @processes: Hash[[String, String], HelperProcess]
      end

      # One helper's process, with the tree of processes it starts.
      class HelperProcess
        # Starts the helper `name` as `command` in `root`, in `tree`, with
        # `environment`'s changes to CrossLint's environment.
        # Raises Core::PluginError, after ending the helper, when `tree`
        # can't hold it.
        def initialize: (String name, [String, String] command, root: String, err: CLI::_Output, debug: bool,
                         time_limit: Numeric, stop_limit: Numeric, tree: _Tree, environment: Hash[String, String?]) -> void

        # Writes `input` as a line of JSON, and returns the line of JSON
        # the helper answers, parsed. Raises Core::PluginError when the
        # helper fails; once it has, every call fails.
        def call: (untyped input) -> untyped

        # Closes the helper's input, waits up to the stop limit for it to
        # exit, and ends its tree.
        def stop: () -> void

        # Ends the helper's tree now.
        def kill: () -> void

        private

        @name: String

        @time_limit: Numeric

        @stop_limit: Numeric

        # Whether kill ended the tree.
        @killed: bool?

        @stdin: IO

        @stdout: IO

        @wait: Process::Waiter

        @tree_class: _Tree

        @tree: _TreeProcesses

        # What the helper has written to standard error.
        @written: String

        # Reads what the helper writes to standard error into `@written`,
        # until the helper and everything it started have closed it.
        @reader: Thread

        # The helper's tree. Ends the helper and raises Core::PluginError,
        # saying the helper couldn't be put in one, when it can't be.
        def contain: (IO stderr) -> _TreeProcesses

        # The line the helper answers `input` with, or nil when it exits
        # first.
        def exchange: (untyped input) -> String?

        # `line`, parsed as JSON. Fails the helper when it isn't JSON.
        def parse: (String line) -> untyped

        # Ends the helper's tree, and returns how the helper ended and what
        # it wrote to standard error.
        def finish: () -> [Process::Status, String]

        # Ends the helper and raises the error that says it failed: `what`
        # it did, or how it exited, and what it wrote to standard error.
        def fail!: (?String? what) -> bot
      end
    end
  end
end
