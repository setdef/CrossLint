module CrossLint
  module Adapters
    # The helpers port as processes. Each helper runs as `COMMAND FILE`,
    # its command found on the PATH and its file in its plugin's folder,
    # in the project's root, from its first call to the check's end. A
    # request is one line of JSON on its standard input, and its answer
    # one line of JSON on its standard output. What it writes to standard
    # error goes to CrossLint's standard error under --debug, each line
    # after "crosslint: helper NAME: ", and into the error when it fails.
    #
    # A helper runs in a process tree of its own: a process group on
    # macOS and Linux, a job object on Windows. A helper that doesn't
    # answer within the time limit is ended with every process in its
    # tree, and so is whatever a helper leaves running when the check
    # ends.
    class ProcessHelpers
      include _Helpers

      # How long CrossLint waits for each answer, in seconds, and for a
      # helper to end once its input is closed.
      TIME_LIMIT: Integer

      # Whether CrossLint runs on Windows.
      WINDOWS: bool

      # The process tree this system starts a helper in: JobObject on
      # Windows, ProcessGroup elsewhere.
      TREE: singleton(ProcessGroup) | singleton(JobObject)

      # How long the port waits for each answer, in seconds.
      attr_reader time_limit: Numeric

      # A port that writes what a helper writes to standard error to `err`
      # when `debug` is true, waits `time_limit` seconds for each answer,
      # and finds commands on the PATH in `env`, the environment.
      def initialize: (err: CLI::_Output, debug: bool, ?time_limit: Numeric, ?env: _Environment) -> void

      # What the port reads of the environment, as ENV or a hash has it.
      interface _Environment
        # The value of `name`, or `default` when it is unset.
        def fetch: (String name, String default) -> String
      end

      # The program called `command`: in the first folder of the PATH, each
      # separated by File::PATH_SEPARATOR, that has one, the file named
      # `command` with one of PATHEXT's extensions, separated by ";", or
      # else with none, that is a file Ruby can run. Windows sets PATHEXT,
      # as ".COM;.EXE;.BAT;.CMD" and more; elsewhere it is unset. nil when
      # there is none.
      def find: (String command) -> String?

      private

      @err: CLI::_Output

      @debug: bool

      @env: _Environment

      # The program and file `plugin`'s `helper` runs. Raises Core::Mistake
      # when the program isn't on the PATH or the file isn't in the
      # plugin's folder.
      def command: (Core::Plugin plugin, Core::HelperDeclaration helper) -> [String, String]

      # The helpers of one check.
      class Running
        include _RunningHelpers

        # Helpers that run `commands`, each a program and a file by the
        # plugin's and the helper's names, in `root`.
        def initialize: (String root, Hash[[String, String], [String, String]] commands, err: CLI::_Output, debug: bool,
                         time_limit: Numeric) -> void

        private

        @root: String

        @commands: Hash[[String, String], [String, String]]

        @err: CLI::_Output

        @debug: bool

        @time_limit: Numeric

        @processes: Hash[[String, String], HelperProcess]
      end

      # One helper's process, with the tree of processes it starts.
      class HelperProcess
        # Starts the helper `name` as `command` in `root`.
        def initialize: (String name, [String, String] command, root: String, err: CLI::_Output, debug: bool,
                         time_limit: Numeric) -> void

        # Writes `input` as a line of JSON, and returns the line of JSON
        # the helper answers, parsed. Raises Core::PluginError when the
        # helper fails; once it has, every call fails.
        def call: (untyped input) -> untyped

        # Closes the helper's input, waits up to the time limit for it to
        # exit, and ends its tree.
        def stop: () -> void

        private

        @name: String

        @time_limit: Numeric

        @stdin: IO

        @stdout: IO

        @wait: Process::Waiter

        @tree: ProcessGroup | JobObject

        # Reads what the helper writes to standard error, and returns it
        # once the helper and everything it started have closed it.
        @reader: Thread

        # The line the helper answers `input` with, or nil when it exits
        # first.
        def exchange: (untyped input) -> String?

        # `line`, parsed as JSON. Fails the helper when it isn't JSON.
        def parse: (String line) -> untyped

        # Ends the helper's tree, and returns how the helper ended and what
        # it wrote to standard error.
        def finish: () -> [Process::Status, String]

        # Ends the helper and raises the error that says it failed: `what`
        # it did, or how it exited, and what it wrote to standard error.
        def fail!: (?String? what) -> bot
      end
    end
  end
end
