module CrossLint
  module Adapters
    # The configuration port for FILE, `.config/crosslint/config.kdl` in a
    # project's root, read as the configuration reference says. find_root
    # raises Core::Mistake when the folder it starts from doesn't exist.
    class KDLConfiguration
      include _Configuration

      # The configuration's path in a project's root.
      FILE: String

      # The nodes the configuration can have at its top.
      NODES: Array[String]

      # The values of `warnings`.
      WARNINGS: Array[String]

      # The values of `verbosity`.
      VERBOSITIES: Array[String]

      # The values of a policy's `severity=`.
      SEVERITIES: Array[String]

      # Where a line ends, as KDL says.
      NEWLINE: Regexp

      # A string, plain or raw, at the position it is matched from: its
      # text is the second group.
      STRING: Regexp

      # What a string can't hold as it is when it is written: a backslash,
      # a quote, a control character, and a line or paragraph separator.
      ESCAPED: Regexp

      # The short escape KDL has for each of those that has one.
      ESCAPES: Hash[String, String]

      private

      # Raises Core::Mistake unless `root` is a folder.
      def folder!: (String root) -> void

      # `configuration` as KDL text.
      def render: (Core::Configuration configuration) -> String

      # One node as KDL text, at `depth` levels of indent, with its
      # children, and a line break at its end.
      def node: (String name, Array[untyped] arguments, Hash[String, untyped] properties, Array[Core::Setting] children, Integer depth) -> String

      # `each` as KDL writes a value: a string in quotes, with escapes,
      # `#true`, `#false`, `#null`, or a number.
      def value: (untyped each) -> String

      # What the `plugin` node `node` is listed as: its name and its path=,
      # or nil.
      def identity: (KDLDocument::Node node) -> [untyped, untyped]

      # Where the text of the ref of the `plugin` node `node` is in
      # `source`, how long it is, and `ref`, to put there. Raises
      # Core::Mistake when the node has no ref with a string, or the ref
      # isn't written as plain text between quotes on one line, with no
      # escape.
      def change: (String source, KDLDocument::Node node, String ref) -> [Integer, Integer, String]

      # The nodes at the top of `document` called `name`.
      def nodes: (KDLDocument document, String name) -> Array[KDLDocument::Node]

      # Reads a `plugin` node.
      def plugin: (KDLDocument document, KDLDocument::Node node) -> Core::ListedPlugin

      # Reads a plugin's setting, with the settings inside it.
      def setting: (KDLDocument::Node node) -> Core::Setting

      # Reads a `policy` node.
      def policy: (KDLDocument document, KDLDocument::Node node) -> Core::PolicySetting

      # Reads the `warnings` or `verbosity` node, set once at most, as one
      # of `choices`.
      def mode: (KDLDocument document, String name, Array[String] choices) -> untyped
    end
  end
end
