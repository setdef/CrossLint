module CrossLint
  module Adapters
    # The CrossLintRuby port for plugins in folders: runs the file of a
    # helper on CrossLint's Ruby from the plugin's folder with
    # Kernel.load, the namespace as the module that wraps it. A file the
    # first one requires, with require_relative or require, runs at the top
    # level.
    class FileCrossLintRuby
      include _CrossLintRuby
    end
  end
end
