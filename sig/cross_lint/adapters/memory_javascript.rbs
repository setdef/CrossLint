module CrossLint
  module Adapters
    # The JavaScript port in memory, for the use cases' tests: what each
    # expression `matches`, as a proc of one text, or the
    # Core::JavaScriptError (Core::InvalidExpression, for an expression
    # JavaScript refuses) that JavaScript would raise for it. An
    # expression it doesn't hold raises one too.
    #
    # ```ruby
    # port = CrossLint::Adapters::MemoryJavaScript.new({"TODO" => ->(text) { text.include?("TODO") }})
    # port.matches("TODO", ["TODO: fix", "done"]) # => [true, false]
    # ```
    class MemoryJavaScript
      include _JavaScript

      # What glob finds for a pattern the port holds no files for.
      NONE: Array[String]

      # A port that answers for `expressions`, by source, and finds the
      # files `globs` holds for each pattern, or none for a pattern it
      # doesn't hold; with `globs` nil, the project has no glob, and with a
      # Core::JavaScriptError, glob raises it.
      def initialize: (?Hash[String, ^(String) -> bool | Core::JavaScriptError] expressions, ?globs: (Hash[String, Array[String]] | Core::JavaScriptError)?) -> void

      private

      @expressions: Hash[String, ^(String) -> bool | Core::JavaScriptError]

      @globs: (Hash[String, Array[String]] | Core::JavaScriptError)?
    end
  end
end
