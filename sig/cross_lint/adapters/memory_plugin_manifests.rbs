module CrossLint
  module Adapters
    # The plugin-manifest port in memory, for the use cases' tests: each
    # plugin's manifest, or the mistake reading it raises, by the absolute
    # path of its folder.
    class MemoryPluginManifests
      include _PluginManifests

      # A port that holds `folders`, by absolute path, and names `file`,
      # and whose manifests have the minimum versions in `minimums`, by
      # absolute path, whatever a folder holds.
      def initialize: (?Hash[String, Core::Manifest | Core::Mistake] folders, ?file: String,
                       ?minimums: Hash[String, Core::MinimumVersion]) -> void

      private

      @folders: Hash[String, Core::Manifest | Core::Mistake]

      @file: String
    end
  end
end
