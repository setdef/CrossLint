module CrossLint
  module Adapters
    # The plugin-Ruby port for plugins in folders: runs a plugin's Ruby
    # file from its folder with Kernel.load, the namespace as the module
    # that wraps it. A file the first one requires, with require_relative
    # or require, runs at the top level.
    class FilePluginRuby
      include _PluginRuby
    end
  end
end
