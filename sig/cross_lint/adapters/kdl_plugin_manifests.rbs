module CrossLint
  module Adapters
    # The plugin-manifest port for FILE, `plugin.kdl` in a plugin's
    # folder, read as the plugin reference says.
    class KDLPluginManifests
      include _PluginManifests

      # The manifest's file name in a plugin's folder.
      FILE: String

      # The nodes a manifest can have at its top.
      NODES: Array[String]

      # The conditions a policy's `when` can state.
      CONDITIONS: Array[String]

      # The values of a rule's `severity=`.
      SEVERITIES: Array[String]

      # What a mistake says about a `flag` node, which an earlier
      # CrossLint read.
      FLAG_MISTAKE: String

      # The type annotations a manifest allows, by node and property: a
      # helper's command=(crosslint).
      TYPED: Hash[String, Hash[String, Array[String]]]

      # The runtimes a helper's command=(crosslint) may name.
      CARRIED: Array[String]

      # How a helper is written.
      HELPER: String

      # What a mistake says about the old ruby= form, with `%s` for the
      # line it is on.
      GONE: String

      private

      # A helper on CrossLint's Ruby, whose file the rules and
      # the artifacts that name it run.
      class Carried < Data
        # The helper's name.
        attr_reader name: String

        # Its file, relative to the plugin's folder.
        attr_reader file: String

        # The line it is declared on.
        attr_reader line: Integer

        # A helper with these fields.
        def self.new: (name: String, file: String, line: Integer) -> instance

        # A helper with these fields.
        def initialize: (name: String, file: String, line: Integer) -> void
      end

      # Each node at the top of `document` called `name`, read by `read`.
      def nodes: [T] (KDLDocument document, String name) { (KDLDocument::Node node) -> T } -> Array[T]

      # Each node at the top of `document` called `name` that takes a name
      # alone, read by the block from its name and line.
      def named_nodes: [T] (KDLDocument document, String name) { (String name, Integer line) -> T } -> Array[T]

      # The name of `node`, which takes nothing else, as `usage` shows.
      def named: (KDLDocument document, KDLDocument::Node node, String usage) -> String

      # Reads an `artifact` node.
      def artifact: (KDLDocument document, KDLDocument::Node node) -> Core::ArtifactDeclaration

      # The regex= of a `primary` node, which may use the placeholders of
      # `primary`, and whose captures can't have their names.
      def primary_regex: (KDLDocument document, KDLDocument::Node node, Core::PathPattern primary) -> Core::Regex?

      # Reads a `piece` node of the artifact `declared`.
      def piece: (KDLDocument document, KDLDocument::Node node, Core::ArtifactDeclaration declared) -> Core::PieceDeclaration

      # The pattern of a `name` node, which may use only the placeholders
      # of `declared`'s primary pattern and the captures of its regex.
      def name_pattern: (KDLDocument document, KDLDocument::Node node, Core::ArtifactDeclaration declared) -> Core::PathPattern

      # The regex= of `node`, which may use the placeholders in `known`, or
      # nil when it has none.
      def regex: (KDLDocument document, KDLDocument::Node node, Array[String] known) -> Core::Regex?

      # The path pattern `source`, written on `node`, which may use
      # `captures` as placeholders.
      def pattern: (KDLDocument document, KDLDocument::Node node, String source, ?Array[String] captures) -> Core::PathPattern

      # Reads a `policy` node.
      def policy: (KDLDocument document, KDLDocument::Node node) -> Core::Policy

      # Reads a policy's `when` node, whose arguments and block state its
      # condition.
      def when_condition: (KDLDocument document, KDLDocument::Node node) -> Core::condition

      # Reads a condition, named by the node's name.
      def condition: (KDLDocument document, KDLDocument::Node node) -> Core::condition

      # The conditions in the block of `not`, `all`, or `any`.
      def conditions: (KDLDocument document, KDLDocument::Node node, String usage, ?nonempty: bool) -> Array[Core::condition]

      # Reads a policy's `rule` node.
      def policy_rule: (KDLDocument document, KDLDocument::Node node) -> Core::PolicyRule

      # Reads a `rule` node, which names the helper that runs the rule;
      # a rule whose helper is one of `carried` is a Ruby rule.
      def rule: (KDLDocument document, KDLDocument::Node node, Array[Carried] carried) -> Core::RuleDeclaration

      # Reads the `artifacts` node, if there is one, which names the helper
      # that declares more artifacts: as the manifest's field for it, one of
      # CrossLint's Ruby for a helper in `carried`, or the
      # helper's name for any other.
      def artifacts: (KDLDocument document, Array[Carried] carried) -> ({artifacts_ruby: Core::ArtifactsRuby} | {artifacts_helper: Core::ArtifactsHelper} | {})

      # Reads a `command` node, and the `flag` nodes in its block.
      def command: (KDLDocument document, KDLDocument::Node node) -> Core::CommandDeclaration

      # Reads a `flag` node in a command's block, written in the usage
      # spec's syntax.
      def command_flag: (KDLDocument document, KDLDocument::Node node) -> Core::CommandFlag

      # Reads a `helper` node: a helper run as a program, or one on
      # CrossLint's Ruby.
      def helper: (KDLDocument document, KDLDocument::Node node) -> (Core::HelperDeclaration | Carried)

      # The helper `name`, with `file`, on the runtime CrossLint carries that
      # `given` names. Raises Core::Mistake for one CrossLint doesn't carry.
      def carried: (KDLDocument document, KDLDocument::Node node, String name, KDLDocument::Typed given, String file) -> Carried

      # The words of a helper's `command` node: its program, then its
      # arguments.
      def command_words: (KDLDocument document, KDLDocument::Node node) -> Array[untyped]

      # Checks that no two of `helpers` have one name. Raises Core::Mistake,
      # naming the line of the second.
      def once: (KDLDocument document, Array[Core::HelperDeclaration | Carried] helpers) -> void

      # Checks that the node has no properties and no children.
      def no_more: (KDLDocument document, KDLDocument::Node node) -> void

      # Checks that the node has no children.
      def no_children: (KDLDocument document, KDLDocument::Node node) -> void
    end
  end
end
