module CrossLint
  module Adapters
    # The report port as JSON: one object on a line of standard output,
    # with the version of the CrossLint that wrote it, the violations, the
    # paid-off entries, and the summary, and nothing else there. Notices,
    # faults, what a step wrote, and the summary line go to standard error
    # as for TextReport. Under --silent it writes only the faults; passing
    # artifacts aren't in the object.
    #
    #     {"crosslint_version":"1.0.0","findings":[{"path":"lib/a.rb","message":"no test file at test/a_test.rb","plugin":"tests",
    #       "policy":"has-test","artifact":"lib/a.rb","role":"ruby-file","severity":"error","detail":null,"line":null}],
    #      "paid_off":[],"summary":{"artifacts":9,"errors":1,"warnings":0,"paid_off":0,"debt":0}}
    #
    # The summary's `debt` is how many violations the check accepted as
    # debt, as the summary line says, whatever --quiet or --warnings=none
    # leaves out of `findings`.
    #
    # A violation's `path` is its artifact's primary piece's path, and its
    # `artifact` is the artifact's name, which a debt file's entry for it
    # has: the same path, unless the artifact's declaration has a name
    # pattern. Its `line` is the line a primary's regex found the
    # artifact on, and null for an artifact whose primary piece is a whole
    # file. A paid-off entry has its `file` and `line`, its `plugin`,
    # `policy`, and `artifact`, and a `message`. The keys are in those
    # orders, and every character that isn't ASCII is escaped.
    class JSONReport < TextReport
      # A report that writes the object to `out` and the rest to `err`,
      # with `crosslint`, the version of the CrossLint that runs, such as
      # "1.0.0", as the object's first key, and each fault's trace when
      # `debug` is true.
      def initialize: (out: CLI::_Output, err: CLI::_Output, crosslint: String, ?debug: bool) -> void

      @crosslint: String
    end
  end
end
