module CrossLint
  module Adapters
    # The report port as JSON: one object on a line of standard output,
    # with the violations, the stale entries, and the summary, and nothing
    # else there. Notices, faults, what a step wrote, and the summary line
    # go to standard error as for TextReport. Under --silent it writes
    # only the faults; passing artifacts aren't in the object.
    #
    #     {"findings":[{"path":"lib/a.rb","message":"no test file at test/a_test.rb","plugin":"tests",
    #       "policy":"has-test","artifact":"lib/a.rb","role":"ruby-file","severity":"error","detail":null}],
    #      "stale":[],"summary":{"artifacts":9,"errors":1,"warnings":0,"stale":0}}
    #
    # A violation's `path` is its artifact's primary file, and its
    # `artifact` is the artifact's name, which a debt file's entry for it
    # has: the same path, unless the artifact's declaration names it
    # otherwise. A stale entry has its `file` and `line`, its `plugin`,
    # `policy`, and `artifact`, and a `message`. The keys are in those
    # orders, and every character that isn't ASCII is escaped.
    class JSONReport < TextReport
    end
  end
end
