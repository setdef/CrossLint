module CrossLint
  # A command line, read by the usage spec: the command in it, if any,
  # and the value of each flag given, or that has a default.
  #
  # A flag is written as --name, --name=value, or --name value, and one
  # with a one-letter name as -n, -nvalue, or -n value, with several
  # one-letter flags in one word, as in -qa. After --, every word is an
  # argument. Before a command, only the top-level flags are known; after
  # it, the command's and the global ones.
  class CommandLine
    # A mistake in the command line, with a message that says how to fix
    # it.
    class Error < StandardError
    end

    # The --help flag, which usage adds to every program and the spec
    # doesn't list.
    HELP: UsageSpec::Flag

    # The --version flag, which usage adds to every program and the spec
    # doesn't list.
    VERSION: UsageSpec::Flag

    # What the person asked for: :help, :version, or :run.
    attr_reader action: :help | :version | :run

    # The command given, or nil for none.
    attr_reader command: UsageSpec::Command?

    # The command that the help command is asked to explain, or nil for
    # none, and for every other command.
    attr_reader topic: UsageSpec::Command?

    # Each flag's value by its long name: true for a flag that takes no
    # value, or the value given or the default.
    attr_reader flags: Hash[String, String | true]

    # Reads `argv` by `spec`, and raises Error at a mistake.
    def initialize: (UsageSpec spec, Array[String] argv) -> void

    # The value given for the flag `long`, or its default, or nil for a
    # flag that takes no value or has none.
    def value: (String long) -> String?

    # Whether the command line gives the flag `long`, as against its
    # default.
    def given?: (String long) -> bool

    # The flags known where the reading is: the top-level flags before a
    # command, and the command's and the global ones after it, with
    # --help and --version.
    def known_flags: () -> Array[UsageSpec::Flag]

    private

    @spec: UsageSpec

    @given: Array[String]

    # Reads `words` until they run out or --help or --version ends the
    # reading.
    def read: (Array[String] words) -> void

    # Reads a flag with a long name, taking its value from `words` when
    # `word` has none.
    def read_long: (String word, Array[String] words) -> void

    # Reads one-letter flags from `letters`, taking a value from `words`
    # when the letters run out.
    def read_short: (String letters, Array[String] words) -> void

    # Sets `flag` to `value`, or ends the reading at --help or --version.
    def set: (UsageSpec::Flag flag, String? value) -> void

    # `value`, checked against what `flag` takes.
    def flag_value: (UsageSpec::Flag flag, String? value) -> String

    # Reads `word` as the command, as what the help command explains, or
    # refuses it after any other command.
    def read_argument: (String word) -> void

    # Reads `word` as the command that the help command explains, or
    # refuses it as a second one.
    def read_topic: (String word) -> void

    # The command named `word`, or a raise of Error that names the nearest
    # one, with `where` as the program or command that has no such command.
    def find_command: (String word, String where) -> UsageSpec::Command

    # The message for a flag named `name` that isn't among `names`.
    def unknown_flag: (String name, Array[String] names) -> String

    # `message`, with the name among `names` that the person most likely
    # meant by `typed`, or where to see them all: `where` --help, with
    # `where` the program or command, as "crosslint check".
    def suggest: (String message, String typed, Array[String] names, String where) -> String

    # The program's name, and the command's when there is one, as
    # "crosslint check".
    def scope: () -> String

    # A word the person typed, quoted when it holds anything but printable
    # ASCII.
    def shown: (String word) -> String

    # Words joined as in a sentence: "a", "a or b", "a, b, or c".
    def list: (Array[String] words) -> String
  end
end
