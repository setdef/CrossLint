module CrossLint
  # A command line, read by the usage spec: the command in it, if any,
  # and the value of each flag given, or that has a default.
  #
  # A flag is written as --name, --name=value, or --name value, and one
  # with a one-letter name as -n, -nvalue, or -n value, with several
  # one-letter flags in one word, as in -qa. After --, every word is an
  # argument. Before a command, only the top-level flags are known; after
  # it, the command's and the global ones.
  class CommandLine
    # A mistake in the command line, with a message that says how to fix
    # it.
    class Error < StandardError
    end

    # The --help flag, which usage adds to every program and the spec
    # doesn't list.
    HELP: UsageSpec::Flag

    # The --version flag, which usage adds to every program and the spec
    # doesn't list.
    VERSION: UsageSpec::Flag

    # What the person asked for: :help, :version, or :run.
    attr_reader action: :help | :version | :run

    # The command given, or nil for none.
    attr_reader command: UsageSpec::Command?

    # The command that the help command is asked to explain, or nil for
    # none, and for every other command.
    attr_reader topic: UsageSpec::Command?

    # The words that are not a command of CrossLint's, in the order
    # given: the first can be a plugin's name and the second its command's.
    # With the help command, the words after it that name no command of
    # CrossLint's. Empty when the line has none.
    attr_reader words: Array[String]

    # `word` as a message quotes it: as it is, or in double quotes with
    # escapes when it holds anything but printable ASCII.
    def self.shown: (String word) -> String

    # Each flag's value by its long name: true for a flag that takes no
    # value, or the value given or the default.
    attr_reader flags: Hash[String, String | true]

    # Reads `argv` by `spec`, and raises Error at a mistake. A flag the
    # spec doesn't give after a command's words, the plugin's name and its
    # command's, is looked up by calling `plugin_flags` with those words and
    # the project given with --project, nil for none; it returns the flags
    # that command declares. `probing` reads the line only for --project,
    # skipping each such flag.
    def initialize: (UsageSpec spec, Array[String] argv, ?plugin_flags: (^(Array[String] words, String? project) -> Array[Core::CommandFlag])?,
                     ?probing: bool) -> void

    # The value given for the flag `long`, or its default, or nil for a
    # flag that takes no value or has none.
    def value: (String long) -> String?

    # Whether the command line gives the flag `long`, as against its
    # default.
    def given?: (String long) -> bool

    # The flags known where the reading is: the top-level flags before a
    # command, and the command's and the global ones after it, with
    # --help and --version, and after a plugin's command, the flags it
    # declares.
    def known_flags: () -> Array[_Flag]

    private

    @argv: Array[String]

    @plugin_flags: (^(Array[String] words, String? project) -> Array[Core::CommandFlag])?

    # Whether the line is read only for --project, skipping each flag the
    # spec doesn't give.
    @probing: bool

    @declared: Hash[Array[String], Array[Core::CommandFlag]]

    # The flags the spec gives where the reading is, without --help and
    # --version, and those of a plugin's command, which the project says.
    def base_flags: () -> Array[UsageSpec::Flag]

    # The flag a block finds among the spec's flags, and only when none is
    # there, among those a plugin's command declares.
    def find_flag: () { (_Flag) -> boolish } -> _Flag?

    # The flags that the plugin's command, named by the first two words,
    # declares, once both are read; none before.
    def declared_flags: () -> Array[Core::CommandFlag]

    # The project given with --project anywhere on the line, or nil, found
    # by reading the line once more without plugin flags.
    def project: () -> String?

    @spec: UsageSpec

    @given: Array[String]

    # Reads `words` until they run out or --help or --version ends the
    # reading.
    def read: (Array[String] words) -> void

    # Reads a flag with a long name, taking its value from `words` when
    # `word` has none.
    def read_long: (String word, Array[String] words) -> void

    # Reads one-letter flags from `letters`, taking a value from `words`
    # when the letters run out.
    def read_short: (String letters, Array[String] words) -> void

    # Sets `flag` to `value`, or ends the reading at --help or --version.
    def set: (_Flag flag, String? value) -> void

    # `value`, checked against what `flag` takes.
    def flag_value: (_Flag flag, String? value) -> String

    # Reads `word` as the command, as one of `words`, as what the help
    # command explains, or refuses it after any other command.
    def read_argument: (String word) -> void

    # Reads `word` as the command that the help command explains, or as
    # one of `words`, or refuses it as a second command.
    def read_topic: (String word) -> void

    # The command of CrossLint's named `word`, or nil.
    def spec_command: (String word) -> UsageSpec::Command?

    # The message for a flag named `name` that isn't among `names`.
    def unknown_flag: (String name, Array[String] names) -> String

    # `message`, with the name among `names` that the person most likely
    # meant by `typed`, or where to see them all: `where` --help, with
    # `where` the program or command, as "crosslint check".
    def suggest: (String message, String typed, Array[String] names, String where) -> String

    # The program's name, and the command's when there is one, or else the
    # words given in its place, as "crosslint check" or "crosslint debt
    # update".
    def scope: () -> String

    # `word`, as `CommandLine.shown` quotes it.
    def shown: (String word) -> String

    # Words joined as in a sentence: "a", "a or b", "a, b, or c".
    def list: (Array[String] words) -> String
  end
end
