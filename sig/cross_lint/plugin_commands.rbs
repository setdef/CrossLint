module CrossLint
  # Reads the words of a command line that no command of CrossLint's
  # takes, such as `debt update`, as a plugin's name and the name of its
  # command, among the plugins a project lists. Raises
  # CommandLine::Error, with a message that says what to type, for a
  # plugin the project doesn't list, a command the plugin doesn't have, and
  # a word that is neither.
  class PluginCommands
    # A reader of words for the usage spec `spec`, whose commands are the
    # ones no plugin's can be.
    def initialize: (UsageSpec spec) -> void

    # Settles the first of `words` before any plugin is fetched or loaded,
    # from what the project's configuration lists: it is the name of a
    # plugin listed, fetched or not, or else this raises Error. When
    # `listing` is the mistake that stopped the reading, only a word near a
    # command of CrossLint's, or a flag's name, is an error, since it may
    # be a plugin's name; any other word raises the mistake, unless
    # `helping`, because help never fails.
    # `built_in` gives the names of the commands of each built-in plugin,
    # which a message may need to name a plugin that isn't listed.
    def resolve: (Array[String] words, Core::PluginListing | Core::Mistake listing, ^() -> Hash[String, Array[String]] built_in, ?helping: bool) -> void

    # The plugin that the first of `words` names, which `resolve` found
    # among `plugins`, and its command, or nil for the command when
    # `words` name the plugin alone.
    def find: (Array[String] words, Array[Core::Plugin] plugins) -> [Core::Plugin, Core::CommandDeclaration?]

    private

    @spec: UsageSpec

    # The names of the shared plugins `listing` lists that aren't fetched.
    def unfetched: (Core::PluginListing listing) -> Array[String]

    # Raises Error naming the nearest command of CrossLint's to `word`, or
    # the flag it is the name of, if there is one, and else raises `mistake`
    # unless `helping`.
    def refuse_unreadable: (String word, Core::Mistake mistake, bool helping) -> void

    # Raises Error for `name`, which no listed plugin has: with the
    # command's place in a built-in plugin the project doesn't list when
    # `word` is one of its commands, or else with the nearest names.
    def unlisted: (String name, String? word, Core::PluginListing listing, ^() -> Hash[String, Array[String]] built_in) -> void

    # The message for `word`, which none of the plugin's `commands` is.
    def missing: (String name, String word, Array[String] commands) -> String

    # The names `word` may be a mistake for: the nearest command of
    # CrossLint's, the nearest of `others`, and the flag it is the name of.
    def guesses: (String word, Array[String] others) -> Array[String]

    # The names of the flags every command takes, as the program's help
    # lists them.
    def flag_names: () -> Array[String]

    # The names of CrossLint's commands.
    def commands: () -> Array[String]

    # The name among `known` that is nearest to `word`, or nil.
    def nearest: (String word, Array[String] known) -> String?

    # The program's name and `words`, as "crosslint debt update".
    def scope: (*String words) -> String

    # `word` as a message quotes it.
    def shown: (String word) -> String

    # An Error with `message`.
    def error: (String message) -> CommandLine::Error
  end
end
