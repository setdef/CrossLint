{
  "name": "spec-per-component",
  "protocol": 1,
  "runtime": { "command": "{host_ruby}", "args": ["{plugin_dir}/plugin.rb"], "min_version": "3.2" },
  "lifetime": "per-check",
  "artifacts": [
    {
      "name": "component",
      "match": "src/**/*.component.ts",
      "companions": { "spec": "{dir}/{base}.component.spec.ts" }
    }
  ]
}
