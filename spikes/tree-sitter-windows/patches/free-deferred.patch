+// For a type whose free function calls into Ruby (allocates an object, looks
+// up or changes a Hash): without RUBY_TYPED_FREE_IMMEDIATELY, Ruby calls the
+// free function after the garbage collection, not during it.
+#define DATA_DECLARE_DATA_TYPE_DEFERRED_FREE(type)                             \
+  DATA_DECLARE_DATA_TYPE_WITH_FLAGS(type, 0)

